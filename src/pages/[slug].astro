---
import { getCollection, render } from 'astro:content';
import DocumentLayout from '../layouts/DocumentLayout.astro';
import { groupForSlug, essayGroups } from '../data/essayGroups';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const group = groupForSlug(d.slug);

/**
 * The group, in the rail rather than in a block after the essay: where to go
 * next, not part of the argument — the same reason the case studies keep their
 * artifacts there.
 *
 * The whole group is listed, including this essay, because a rail showing only
 * the others reports a group of one and gives no sense of what it belongs to.
 * The heading is the group's own statement, read from essayGroups.ts, so it is
 * the sentence the index uses rather than a second phrasing written here.
 */
const all = await getCollection('essays');
const inGroup = group
  ? group.slugs.map((slug) => {
      const e = all.find((x) => x.data.slug === slug)!;
      return { href: `/${slug}`, label: e.data.title, current: slug === d.slug };
    })
  : [];
const siblings = [...inGroup, { href: '/essays', label: 'All six essays' }];
---

<DocumentLayout
  title={d.title}
  deck={d.deck}
  titleDraft={d.titleDraft}
  pull={d.pull}
  metaTitle={d.metaTitle}
  description={d.description}
  descriptionDraft={d.descriptionDraft}
  metaWarning={d.metaWarning}
  eyebrow={group?.label ?? 'Essay'}
  meta={[
    ['Contribution', d.contribution],
    ['Role', d.role],
    ['Scope', d.scope],
    ['Takeaway', d.takeaway],
  ]}
  links={siblings}
  linksLabel={group?.label ?? 'Essays'}
  linksTitle={group?.statement}
>
  <Content />
</DocumentLayout>

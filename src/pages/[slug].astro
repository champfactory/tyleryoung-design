---
import { getCollection, render } from 'astro:content';
import DocumentLayout from '../layouts/DocumentLayout.astro';
import { groupForSlug, essayGroups } from '../data/essayGroups';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const group = groupForSlug(d.slug);

/**
 * The rest of the group, in the rail rather than in a block after the essay.
 * They are where to go next, not part of the argument — the same reason the
 * case studies keep their artifacts there.
 */
const siblings = group
  ? (await getCollection('essays'))
      .filter((e) => group.slugs.includes(e.data.slug) && e.data.slug !== d.slug)
      .sort((a, b) => group.slugs.indexOf(a.data.slug) - group.slugs.indexOf(b.data.slug))
      .map((e) => ({ href: `/${e.data.slug}`, label: e.data.title }))
  : [];
---

<DocumentLayout
  title={d.title}
  deck={d.deck}
  titleDraft={d.titleDraft}
  pull={d.pull}
  metaTitle={d.metaTitle}
  description={d.description}={d.descriptionDraft}
  metaWarning={d.metaWarning}
  eyebrow={group?.label ?? 'Essay'}
  meta={[
    ['Contribution', d.contribution],
    ['Role', d.role],
    ['Scope', d.scope],
    ['Takeaway', d.takeaway],
  ]}
  links={siblings}
  linksLabel={group ? `More in ${group.label}` : 'More essays'}
>
  <Content />
</DocumentLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import LiveFrame from '../components/LiveFrame.astro';
import Needs from '../components/Needs.astro';
import Draft from '../components/Draft.astro';
import { stories } from '../data/stories';
import { essayGroups } from '../data/essayGroups';

const bioRest = [
  'He specializes in aligning product design with business outcomes, scaling high-impact teams, and embedding user-centered thinking into roadmap planning.',
  'His work spans product strategy, systems thinking, and operational rigor — driving measurable impact across growth-stage and enterprise orgs.',
];

const references = [
  {
    name: 'Chris Macomber',
    title: 'VP of Product',
    quote:
      'He didn’t just advocate for quality—he reframed it in terms of business risk, user value, and strategic opportunity. His ability to structure design tradeoffs gave our team sharper product decisions and faster momentum.',
    href: '#',
  },
  {
    name: 'Arnab Bhattacharya',
    title: 'Associate VP of Product',
    quote:
      'His approach to design integration eliminated silos and embedded design thinking throughout our product development process. Tyler revolutionized our feedback loops and championed insightful consumer research, reducing design cycles while improving quality significantly.',
  },
  {
    name: 'Jessica Zhu',
    title: 'Associate VP of Product',
    quote:
      'As I led the development of our AI and business intelligence platforms, Tyler was a deeply collaborative partner—someone who brought structure, perspective, and a steadying influence to complex system decisions.',
  },
];
---

<BaseLayout
  title="Tyler Young | Senior Director of Design"
  description="I design software and the systems that generate it — and the constraints that decide what an agent is allowed to produce."
>
  <!-- ----------------------------------------------------------- STORIES ---
       Three. Attention collapses after the third; a fourth would not be read. -->
  <section class="shell stories" aria-labelledby="work">
    <h2 class="sr-only" id="work">Selected work</h2>

    <StoryCard story={stories[0]}>
      <div slot="media">
        <LiveFrame
          src="https://alucify-screens.fly.dev/#/dashboard"
          host="alucify-screens.fly.dev"
          title="The Alucify dashboard, running"
          note="The design, rebuilt as a working app. Blast radius, agent hours and token cost are summed from the concepts behind them."
        />
      </div>
    </StoryCard>

    <StoryCard story={stories[1]}>
      <div slot="media">
        <LiveFrame
          src="https://atheer-next.fly.dev/"
          host="atheer-next.fly.dev"
          title="The operations surface, live"
          note="The running product. Status shapes sit on the nav items and job IDs."
        />
      </div>
    </StoryCard>

    <StoryCard story={stories[2]}>
      <div slot="media">
        <LiveFrame
          src="https://metin-oasis-v6.fly.dev/"
          host="metin-oasis-v6.fly.dev"
          title="The operations build that was reviewed, running"
          note="The build that was reviewed. The next version is at its own URL."
        />
      </div>
    </StoryCard>
  </section>

  <!-- -------------------------------------------------------------- MORE ---
       Everything the executive audience needs, one tier down. Not competing
       with the three stories for a first-pass reader's attention. -->
  <!-- ------------------------------------------------------- REFERENCES ---
       Three people who worked alongside the role being hired for, read side by
       side. On its own band, the way the header is on one. -->
  <section class="refs-band" id="references" aria-labelledby="refs-label">
    <div class="shell">
      <p class="label" id="refs-label">References</p>
      <div class="refs">
        {
          references.map((r) => (
            <figure class="ref">
              <blockquote>{r.quote}</blockquote>
              <figcaption>
                <span class="ref-name">{r.name}</span>
                <span class="ref-title">{r.title}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* -------------------------------------------------------------- stories */
  .stories {
    padding-top: 84px;
    display: grid;
    gap: 76px;
  }

  /* ----------------------------------------------------------------- more */
  /* A full-bleed band, like the header. Same construction: colour on the
     section, the shell inside it holding the measure. */
  .refs-band {
    margin-top: 108px;
    padding-block: 56px 64px;
    background: var(--color-accent);
    border-top: 1px solid var(--color-accent-rule);
    border-bottom: 1px solid var(--color-accent-rule);
  }

  .refs {
    display: grid;
    gap: 32px;
    margin-top: 12px;
  }

  .ref {
    margin: 0;
  }

  blockquote {
    margin: 0 0 8px;
    font-size: var(--text-note);
    line-height: 1.58;
    color: var(--color-ink);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }

  .ref-name,
  .ref-title {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .ref-name {
    font-weight: 600;
    color: var(--color-ink);
  }

  .ref-title {
    color: var(--color-ink-3);
  }





  @media (min-width: 810px) {
    .hero {
      padding-top: 120px;
    }

    /* The three references span the page, one per column. */
    .refs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
      align-items: start;
    }
  }

  @media (min-width: 1000px) {
    .stories {
      gap: 96px;
    }
  }
</style>

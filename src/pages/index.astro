---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import LiveFrame from '../components/LiveFrame.astro';
import Shot from '../components/Shot.astro';
import SurfaceLedger from '../components/SurfaceLedger.astro';
import Needs from '../components/Needs.astro';
import { stories } from '../data/stories';
import { REPO } from '../data/site.mjs';
import { essayGroups } from '../data/essayGroups';

// Ported verbatim from the live site. Do not edit without Tyler.
const bioLede =
  'Tyler Young is a senior design executive who helps companies turn design from a delivery function into a strategic advantage.';
const bioRest = [
  'He specializes in aligning product design with business outcomes, scaling high-impact teams, and embedding user-centered thinking into roadmap planning.',
  'His work spans product strategy, systems thinking, and operational rigor — driving measurable impact across growth-stage and enterprise orgs.',
];

const references = [
  {
    name: 'Chris Macomber',
    title: 'VP of Product',
    quote:
      'He didn’t just advocate for quality—he reframed it in terms of business risk, user value, and strategic opportunity. His ability to structure design tradeoffs gave our team sharper product decisions and faster momentum.',
    href: '#',
  },
  {
    name: 'Arnab Bhattacharya',
    title: 'Associate VP of Product',
    quote:
      'His approach to design integration eliminated silos and embedded design thinking throughout our product development process. Tyler revolutionized our feedback loops and championed insightful consumer research, reducing design cycles while improving quality significantly.',
  },
  {
    name: 'Jessica Zhu',
    title: 'Associate VP of Product',
    quote:
      'As I led the development of our AI and business intelligence platforms, Tyler was a deeply collaborative partner—someone who brought structure, perspective, and a steadying influence to complex system decisions.',
  },
];
---

<BaseLayout
  title="Tyler Young | Senior Director of Design"
  description={bioLede}
>
  <!-- ------------------------------------------------------------- HERO ---
       15-second read: who, what he does now, and three ways in. Nothing else. -->
  <section class="shell hero">
    <p class="label" data-rise style="--i:0">Senior Director of Design · Portfolio 2026</p>
    <h1 class="display name" data-rise style="--i:1">Tyler Young</h1>

    <p class="lede" data-rise style="--i:2">{bioLede}</p>

    <p class="ai-line" data-rise style="--i:3">
      <Needs>
        one sentence on current AI-native practice — the single most load-bearing
        line on this site. Tyler writes or approves it.
      </Needs>
    </p>

    <p class="thesis-line" data-rise style="--i:4">
      <a class="thesis" href="/how-i-design-with-ai">
        How I design with AI <span aria-hidden="true">→</span>
      </a>
    </p>

    <ul class="proof" data-rise style="--i:4">
      <li><a href="https://atheer-next.fly.dev/" target="_blank" rel="noopener">2 live deployments</a></li>
      <li><a href="https://atheer-next-storybook.fly.dev/" target="_blank" rel="noopener">96 components · 51 stories</a></li>
      <li><a href="/atheer-design-pipeline">1,048-line operating spec</a></li>
      <li><a href={REPO} target="_blank" rel="noopener">This site's source</a></li>
      <li><a href="/colophon">Audits that run on every build</a></li>
    </ul>
  </section>

  <!-- ----------------------------------------------------------- STORIES ---
       Three. Attention collapses after the third; a fourth would not be read. -->
  <section class="shell stories" aria-labelledby="work">
    <h2 class="sr-only" id="work">Selected work</h2>

    <StoryCard story={stories[0]}>
      <div slot="media">
        <Shot
          src="/work/alucify/dashboard.png"
          alt="Alucify dashboard showing artifact status, coverage analysis at 89 percent, and impact analysis reporting 87 percent blast radius, 240 agent hours and a 5M token cost."
          state="Tenured user dashboard"
        />
      </div>
    </StoryCard>

    <StoryCard story={stories[1]}>
      <div slot="media">
        <LiveFrame
          src="https://atheer-next.fly.dev/"
          host="atheer-next.fly.dev"
          title="The operations surface, live"
          note="The running product. Status shapes sit on the nav items and job IDs."
        />
      </div>
    </StoryCard>

    <StoryCard story={stories[2]}>
      <div slot="media">
        <SurfaceLedger />
      </div>
    </StoryCard>
  </section>

  <!-- -------------------------------------------------------------- MORE ---
       Everything the executive audience needs, one tier down. Not competing
       with the three stories for a first-pass reader's attention. -->
  <section class="shell more">
    <div class="more-head">
      <span class="num">·</span>
      <span class="name-label">More</span>
    </div>

    <div class="more-grid">
      <div class="col">
        <p class="label">Leadership writing</p>
        <p class="col-lede">
          Nine essays on building design orgs — the long-form versions of what runs
          underneath the work above.
        </p>
        <ul class="plain">
          {essayGroups.map((g) => <li>{g.title}</li>)}
        </ul>
        <p class="col-link">
          <a class="artifact" href="/essays">
            Read the essays
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>

      <div class="col">
        <p class="label">In short</p>
        <p class="col-lede">{bioRest[0]}</p>
        <p class="col-lede">{bioRest[1]}</p>
        <p class="col-link">
          <a class="artifact" href="/tldr">
            TL;DR
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>

      <div class="col">
        <p class="label">References</p>
        <div class="refs">
          {
            references.map((r) => (
              <figure class="ref">
                <blockquote>{r.quote}</blockquote>
                <figcaption>
                  <span class="ref-name">{r.name}</span>
                  <span class="ref-title">{r.title}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>

    <p class="legend">
      <span class="k draft-key">Dotted</span> = draft copy awaiting Tyler's approval.{' '}
      <span class="k needs-key">NEEDS</span> = missing asset or open decision. Neither
      ships. Headshots are held back until the photo↔person mapping is confirmed.
    </p>
  </section>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---------------------------------------------------------------- hero */
  .hero {
    padding-top: 88px;
    padding-bottom: 76px;
  }

  .name {
    font-size: clamp(52px, 12vw, 132px);
    margin: 18px 0 0;
  }

  .lede {
    margin: 30px 0 0;
    max-width: 34ch;
    font-size: clamp(21px, 2.6vw, 27px);
    line-height: 1.42;
    text-wrap: pretty;
  }

  .ai-line {
    margin: 26px 0 0;
    max-width: 60ch;
  }

  .thesis-line {
    margin: 22px 0 0;
  }

  /* The connective thesis, in the structure rather than buried two pages down. */
  .thesis {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-ink);
    padding-bottom: 3px;
  }

  .thesis:hover {
    color: var(--color-signal);
    border-bottom-color: var(--color-signal);
  }

  /* The 15-second layer: every claim on this row is checkable in one click. */
  .proof {
    list-style: none;
    margin: 40px 0 0;
    padding: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
  }

  .proof a {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule-strong);
    padding-bottom: 3px;
    transition: color 120ms ease, border-color 120ms ease;
  }

  .proof a:hover {
    color: var(--color-signal);
    border-bottom-color: var(--color-signal);
  }

  /* -------------------------------------------------------------- stories */
  .stories {
    display: grid;
    gap: 76px;
  }

  /* ----------------------------------------------------------------- more */
  .more {
    padding-top: 108px;
  }

  .more-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-top: 14px;
    margin-bottom: 40px;
  }

  .more-head .num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.09em;
    color: var(--color-signal);
  }

  .name-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .more-grid {
    display: grid;
    gap: 48px;
  }

  .col-lede {
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 44ch;
  }

  .plain {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 7px;
  }

  .plain li {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .col-link {
    margin: 22px 0 0;
  }

  .refs {
    display: grid;
    gap: 24px;
    margin-top: 12px;
  }

  .ref {
    margin: 0;
  }

  blockquote {
    margin: 0 0 8px;
    font-size: 16px;
    line-height: 1.58;
    color: var(--color-ink-2);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }

  .ref-name,
  .ref-title {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .ref-name {
    font-weight: 600;
    color: var(--color-ink);
  }

  .ref-title {
    color: var(--color-ink-3);
  }

  .legend {
    margin: 64px 0 0;
    padding-top: 20px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: var(--color-ink-3);
    max-width: 78ch;
  }

  .k {
    color: var(--color-ink);
    padding-bottom: 1px;
  }

  .draft-key {
    border-bottom: 1px dotted var(--color-signal);
  }

  .needs-key {
    color: var(--color-signal);
    border-bottom: 1px dashed var(--color-signal);
  }

  @media (min-width: 810px) {
    .hero {
      padding-top: 120px;
    }

    .more-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
    }
  }

  @media (min-width: 1000px) {
    .stories {
      gap: 96px;
    }
  }
</style>

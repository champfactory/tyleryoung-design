---
import SystemLayout from '../layouts/SystemLayout.astro';
import { surfaces, inks, lines, machine, type, space, radii, marks, rules, documented } from '../data/system.mjs';

/**
 * A specification, written as one.
 *
 * The previous version opened with three paragraphs arguing that a design
 * system cannot be written before the work — an essay opening on a reference
 * page, where a reader looking for a value had to get past the thesis to reach
 * the first token. Each family led with a rhetorical question rather than a
 * definition, and each rule was two untitled paragraphs, so none of them could
 * be scanned or quoted.
 *
 * One sentence of thesis survives, and it sits with the rules, because the
 * defect behind each rule is the only part of this page that could not have
 * been copied off any other site.
 *
 * Every value is read from global.css at build time, and scripts/tokens.mjs
 * fails the build if a token exists there and is not documented here.
 */
const swatch = (v) => `background:${v}`;
---

<SystemLayout
  metaTitle="Design system — tokens, marks and rules | Tyler Young"
  description="The eight token families tyleryoung.design is built from — surface, ink, line, type, space, radius, mark and machine — read from the stylesheet that defines them, with the rules they resolve to."
  kicker="TYD Design system"
>
  <p class="sys-lede">
    TYD uses eight token families: surface, ink, line, type, space, radius,
    mark, and machine. Each family standardises a pattern found across the
    published site.
  </p>
  <p>
    The values below are generated from <code>global.css</code> at build time, so
    this specification always matches the implementation. A check runs before the
    build and fails it if a colour token exists in the stylesheet and is not
    documented here. All {documented.length} are.
  </p>

  <h2>Surface</h2>
  <p>
    Surface tokens distinguish the page, raised content, sunk panels, alternating
    rows, mounted evidence, and the paper artwork is printed on.
  </p>

  <ul class="sys-grid">
    {
      surfaces.map((s) => (
        <li>
          <span class="sys-swatch" style={swatch(s.value)} aria-hidden="true" />
          <span class="sys-name">{s.name}</span>
          <span class="sys-value">{s.value}</span>
          <span class="sys-use">{s.use}</span>
          <span class="sys-meta">
            {Math.round(s.h)}° · {s.s.toFixed(0)}% · {s.l.toFixed(0)}%
            {s.onInk !== null && <> — {s.onInk.toFixed(2)}:1 against ink</>}
          </span>
        </li>
      ))
    }
  </ul>

  <h2>Ink</h2>
  <p>
    Ink tokens establish text hierarchy. The signal colour is reserved for
    links, and every surface above is that same hue at a tenth of its
    saturation.
  </p>

  <ul class="sys-grid">
    {
      inks.map((i) => (
        <li>
          <span class="sys-swatch" style={swatch(i.value)} aria-hidden="true" />
          <span class="sys-name">{i.name}</span>
          <span class="sys-value">{i.value}</span>
          <span class="sys-use">{i.use}</span>
          <span class="sys-meta">{Math.round(i.h)}° · {i.s.toFixed(0)}% · {i.l.toFixed(0)}%</span>
        </li>
      ))
    }
  </ul>

  <h2>Line</h2>
  <p>Two hairline weights, because a divider and a boundary are not the same thing.</p>

  <ul class="sys-grid">
    {
      lines.map((l) => (
        <li>
          <span class="sys-swatch" style={swatch(l.value)} aria-hidden="true" />
          <span class="sys-name">{l.name}</span>
          <span class="sys-value">{l.value}</span>
          <span class="sys-use">{l.use}</span>
        </li>
      ))
    }
  </ul>

  <h2>Type</h2>
  <p>Type tokens define nine text roles, each shown here at its own size.</p>

  <ul class="sys-type">
    {
      type.map((t) => (
        <li>
          <span class="sys-name">{t.name.replace('text-', '')}</span>
          <span class="sys-value">{t.value}</span>
          <span class="sys-use">{t.use}</span>
          <span class="sys-specimen" style={`font-size:${t.value}`}>Aa</span>
        </li>
      ))
    }
  </ul>

  <h2>Space</h2>
  <p>
    Space tokens define the vertical intervals between major page elements, each
    drawn here at its own height.
  </p>

  <ul class="sys-space">
    {
      space.map((s) => (
        <li>
          <span class="sys-name">{s.name.replace('space-', '')}</span>
          <span class="sys-value">{s.value}</span>
          <span class="sys-use">{s.use}</span>
          <span class="sys-bar" style={`height:${s.value}`} aria-hidden="true" />
        </li>
      ))
    }
  </ul>

  <h2>Radius</h2>
  <p>
    Two corner radii, each drawn here at its own value. Every mat on the site
    takes the first; anything sitting on a mat takes the second.
  </p>

  <ul class="sys-grid">
    {
      radii.map((r) => (
        <li>
          <span class="sys-swatch" style={`background:var(--color-machine-ink);opacity:.14;border-radius:${r.value}`} aria-hidden="true" />
          <span class="sys-name">{r.name.replace('radius-', '')}</span>
          <span class="sys-value">{r.value}</span>
          <span class="sys-use">{r.use}</span>
        </li>
      ))
    }
  </ul>

  <h2>Mark</h2>
  <p>
    Mark tokens identify list items and sequence states. Each mark inherits the
    colour of its surrounding text.
  </p>

  <ul class="sys-marks">
    {
      marks.map(([name, use]) => (
        <li>
          <span class="sys-mark" style={`-webkit-mask-image:var(--mark-${name});mask-image:var(--mark-${name})`} aria-hidden="true" />
          <span class="sys-name">{name}</span>
          <span class="sys-use">{use}</span>
        </li>
      ))
    }
  </ul>

  <h2>Machine</h2>
  <p>
    The dark counterpart, for terminals, code, and receipts — and for this page,
    which is why it is documented rather than treated as a local exception.
  </p>

  <ul class="sys-grid">
    {
      machine.map((m) => (
        <li>
          <span class="sys-swatch" style={swatch(m.value)} aria-hidden="true" />
          <span class="sys-name">{m.name}</span>
          <span class="sys-value">{m.value}</span>
          <span class="sys-use">{m.use}</span>
        </li>
      ))
    }
  </ul>

  <h2>Rules</h2>
  <p>
    These rules replace repeated or conflicting implementations. Each one exists
    because the same decision was made twice, and the defect that produced it is
    the part of this page that could not have been copied from anywhere else.
  </p>

  <ol class="sys-rules stack">
    {
      rules.map((r) => (
        <li>
          <h3 class="sys-rule">{r.title}</h3>
          <p class="sys-statement">{r.statement}</p>
          <p class="sys-why">{r.why}</p>
        </li>
      ))
    }
  </ol>
</SystemLayout>

<style is:global>
  /* Members of a family, side by side, because a family is only judgeable in
     comparison. Each row carries what it is, what it is worth, and where it is
     used — the three things a token page usually leaves to a name. */
  .sys-grid,
  .sys-marks,
  .sys-rules,
  .sys-space,
  .sys-type {
    list-style: none;
    display: grid;
    gap: 2px;
    margin: 30px 0 var(--space-block);
    padding: 0;
    border-radius: var(--radius-mat);
    overflow: hidden;
  }

  /* The rules are a stack: .stack owns the 2px and the outer corners. */
  .sys-rules {
    border-radius: 0;
    overflow: visible;
  }

  .sys-grid > li {
    display: grid;
    grid-template-columns: 34px minmax(0, 10rem) minmax(0, 6rem) minmax(0, 1fr);
    align-items: center;
    gap: 6px 16px;
    margin: 0;
    padding: 12px 14px;
    background: var(--color-machine-raised);
  }

  .sys-grid > li:nth-child(odd) {
    background: var(--color-machine-band);
  }

  .sys-swatch {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-inset);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }

  .sys-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-machine-ink);
  }

  .sys-value {
    font-family: var(--font-code);
    font-size: 13px;
    color: var(--color-machine-ink-2);
  }

  .sys-use {
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-machine-ink-2);
    text-wrap: pretty;
  }

  .sys-meta {
    grid-column: 2 / -1;
    font-family: var(--font-code);
    font-size: 12px;
    color: var(--color-machine-ink-2);
  }

  /* Type and space are the two families a label cannot document. Both rows
     carry the description as well, but the specimen is the specification — a
     step is only judgeable against the step above it. */
  .sys-type > li {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 6rem) minmax(0, 1fr) minmax(0, 6rem);
    align-items: center;
    gap: 16px;
    margin: 0;
    padding: 12px 14px;
    background: var(--color-machine-raised);
    overflow: hidden;
  }

  .sys-type > li:nth-child(odd) {
    background: var(--color-machine-band);
  }

  .sys-specimen {
    font-family: var(--font-prose);
    line-height: 1;
    text-align: right;
    color: var(--color-machine-ink);
  }

  .sys-space > li {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 6rem) minmax(0, 1fr);
    align-items: baseline;
    gap: 6px 16px;
    margin: 0;
    padding: 12px 14px;
    background: var(--color-machine-raised);
  }

  .sys-space > li:nth-child(odd) {
    background: var(--color-machine-band);
  }

  .sys-bar {
    display: block;
    grid-column: 1 / -1;
    width: 100%;
    margin-top: 8px;
    background: var(--color-machine-ink);
    opacity: 0.14;
  }

  .sys-marks > li {
    display: grid;
    grid-template-columns: 34px minmax(0, 10rem) minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    margin: 0;
    padding: 12px 14px;
    background: var(--color-machine-raised);
  }

  .sys-marks > li:nth-child(odd) {
    background: var(--color-machine-band);
  }

  .sys-mark {
    display: block;
    width: 20px;
    height: 20px;
    margin-inline: auto;
    background: var(--color-machine-ink);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  /* A rule you can cite: an imperative title, the rule itself, then what went
     wrong that made it necessary. */
  .sys-rules > li {
    margin: 0;
    padding: 20px;
    background: var(--color-machine-raised);
  }

  body.sys .sys-rule {
    margin: 0;
    font-family: var(--font-code);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-machine-ink-2);
  }

  .sys-statement {
    margin: 12px 0 0 !important;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.45 !important;
    color: var(--color-machine-ink) !important;
    text-wrap: pretty;
  }

  .sys-why {
    margin: 8px 0 0 !important;
    font-size: 15px !important;
    line-height: 1.55 !important;
    color: var(--color-machine-ink-2) !important;
    text-wrap: pretty;
  }

  @media (max-width: 700px) {
    .sys-grid > li,
    .sys-marks > li {
      grid-template-columns: 34px minmax(0, 1fr);
    }

    .sys-type > li,
    .sys-space > li {
      grid-template-columns: minmax(0, 1fr);
    }

    .sys-grid .sys-value,
    .sys-grid .sys-use,
    .sys-marks .sys-use,
    .sys-meta {
      grid-column: 2 / -1;
    }

    .sys-specimen {
      text-align: left;
    }
  }
</style>

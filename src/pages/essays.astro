---
import BaseLayout from '../layouts/BaseLayout.astro';
import Display from '../components/Display.astro';

/**
 * Three dimensions of the work, equal in weight — related, not sequential, so
 * nothing here draws an arrow between them.
 */
const frames = [
  ['Planning', 'Deciding what is worth building before priorities harden.'],
  ['Standards', 'Making quality consistent without routing every decision through design leadership.'],
  ['People', 'Developing designers who can own problems, influence direction, and raise the standard themselves.'],
];

const sections = [
  {
    label: 'Planning',
    statement: 'Put design into the decision, not just the delivery',
    intro: [
      'Design was entering after priorities had hardened. Its reasoning appeared during execution, when changing the problem, scope, or investment was already expensive.',
      'I introduced tools that made user value, business value, and complexity visible while teams could still act on them.',
    ],
    cards: [
      {
        lever: 'Value',
        title: 'Translated design into business terms',
        paras: [
          'Design proposals were being judged as visual improvements because their value remained implicit.',
          'In partnership with product leadership, I introduced a taxonomy of design work, mapped it to company metrics, and created a rubric for evaluating user value, business value, implementation effort, and risk.',
        ],
        evidence: 'Executives began using the resulting design levers in funding meetings.',
        link: 'Three models that tied design to business metrics',
        href: '/how-i-translated-design-work',
        fig: '/work/essays/how-i-translated-design-work/fig-2.svg',
        alt: 'Two-by-two placing the four business levers: efficiency in operation and now, growth in operation and future, retention in customer and now, strategic alignment in customer and future.',
      },
      {
        lever: 'Scope',
        title: 'Made complexity a scoping constraint',
        paras: [
          'Everyone agreed that simplicity mattered, but nobody had a shared way to defend it.',
          'I introduced a complexity budget that measured decision, attention, and orientation load across a flow. Product, research, design, and engineering could identify where scope was asking too much of users — and reduce it before overbuild reached the interface.',
        ],
        evidence: 'Teams stopped treating complexity as something to polish and began treating it as a cost to justify.',
        link: 'A complexity budget for scope decisions',
        href: '/how-i-managed-ux-complexity',
        fig: '/work/essays/how-i-managed-ux-complexity/fig-2.svg',
        alt: 'Heat map scoring four product flows against decision, attention and orientation load, the heaviest cells shaded darkest.',
      },
    ],
  },
  {
    label: 'Standards',
    statement: 'Made quality something other teams could depend on',
    intro: [
      'Standards do not scale because a design leader declares them. They scale when teams find them useful enough to build their own work around.',
      'I established shared foundations for how products were made and a clearer threshold for when continued work stopped improving the outcome.',
    ],
    cards: [
      {
        lever: 'Coherence',
        title: 'Built a design system five functions chose to use',
        paras: [
          'Product quality was drifting across siloed teams, conflicting standards, and repeated handoff failures.',
          'I led a global system of more than 200 components that connected product, engineering, creative, marketing, and planning.',
          'Adoption spread through usefulness rather than mandate. Product managers learned the system, engineering mirrored its foundations, and teams began assuming its availability when planning new work.',
        ],
        evidence: 'What began as a design initiative became shared organizational infrastructure across five functions.',
        link: 'A design system five functions chose to adopt',
        href: '/how-i-scaled-design-efficiency',
        fig: '/work/essays/how-i-scaled-design-efficiency/fig-1.svg',
        alt: 'Three layers of design-system trust: shared language produces alignment, shared structure produces consistency, shared infrastructure produces velocity.',
      },
      {
        lever: 'Restraint',
        title: 'Made “good enough” a deliberate threshold',
        paras: [
          'Teams rushed through problem definition, then pursued perfection during execution.',
          'I introduced a deliberate double standard: “good enough” was a bar to exceed while defining the problem and a threshold to defend once the work had delivered its intended value.',
          'Designers learned when to challenge assumptions, when to commit, and when additional work no longer justified its cost.',
        ],
        evidence: 'The team became more rigorous about defining the problem and more disciplined about stopping once the intended value had been delivered.',
        link: 'Knowing when to stop building',
        href: '/how-i-built-culture-around-paradox',
        fig: '/work/essays/how-i-built-culture-around-paradox/fig-1.svg',
        alt: 'Before and after table on team decision maturity: problem framing, alignment on success and knowing when to stop each move from implicit to deliberate.',
      },
    ],
  },
  {
    label: 'People',
    statement: 'Developed designers to own more than execution',
    intro: [
      'Moving design upstream would mean little if only its leader could operate there.',
      'I changed the structure of the team and the definition of advancement so designers could own complete problems, influence product direction, and develop judgment through real strategic work.',
    ],
    cards: [
      {
        lever: 'Ownership',
        title: 'Rebuilt specialist roles around product ownership',
        paras: [
          'After the pandemic reduced the team and changed the pace of the work, a structure built around UX and visual-design handoffs became too brittle.',
          'I rebuilt the group around junior product-design generalists and coached them to own work from early framing through final delivery.',
        ],
        evidence: 'Junior designers delivered work previously handled by senior specialists with greater speed and fewer dependencies, then grew into cross-functional planning and mentorship.',
        link: 'Rebuilding the team from specialists to generalists',
        href: '/how-i-unlocked-team-trust',
        fig: '/work/essays/how-i-unlocked-team-trust/fig-1.svg',
        alt: 'Before and after diagram of the team’s shape: separate specialist groups become one ring of product-design generalists around the product.',
      },
      {
        lever: 'Growth',
        title: 'Rewarded influence, not just output',
        paras: [
          'The existing career path rewarded execution strength while leaving capable designers outside strategic conversations.',
          'I introduced a development model that made problem framing, recommendations, strategic influence, systems advocacy, and mentorship visible parts of advancement.',
          'Designers practiced those skills in roadmap and tradeoff conversations — not only during critique.',
        ],
        evidence: 'Career growth became connected to how designers shaped product direction, not simply how much work they delivered.',
        link: 'Promoting designers for influence, not output',
        href: '/how-i-shaped-cross-functional-reputation',
        fig: '/work/essays/how-i-shaped-cross-functional-reputation/fig-1.svg',
        alt: 'A five-stage growth loop running from structure to trust to opportunity to visibility to advancement, and back.',
      },
    ],
  },
];
---

<BaseLayout
  title="I build design teams that make better product decisions"
  metaTitle="I build design teams that make better product decisions | Tyler Young"
  description="Most design teams are measured by what they deliver. I built mine to improve the decisions that determine what gets delivered — how opportunities were framed, how complexity was challenged, how quality traveled, and how designers grew."
  current="essays"
>
  <header class="shell hero">
    <p class="label">How I lead</p>
    <div class="hero-cap">
      <Display text="I build design teams that make better product decisions">
        I build design teams that make better product decisions
      </Display>
    </div>
    <p class="open">
      Most design teams are measured by what they deliver. I built mine to
      improve the decisions that determine what gets delivered.
    </p>
    <p class="open dim">
      That meant changing how opportunities were framed, how complexity was
      challenged, how quality traveled across teams, and how designers grew into
      broader ownership. These six stories cover three parts of that work.
    </p>

    <ul class="frames">
      {
        frames.map(([name, what]) => (
          <li>
            <h2 class="frame-name">{name}</h2>
            <p class="frame-what">{what}</p>
          </li>
        ))
      }
    </ul>
  </header>

  {
    sections.map((sec, si) => (
      <section class="shell block" aria-labelledby={`sec-${si}`}>
        <p class="label">{sec.label}</p>
        <h2 class="heading statement" id={`sec-${si}`}>{sec.statement}</h2>
        {sec.intro.map((p) => <p class="sec-intro">{p}</p>)}

        {sec.cards.map((c, ci) => (
          <article class="card">
            <a class="media" href={c.href} tabindex="-1" aria-hidden="true">
              <img src={c.fig} alt={c.alt} loading="lazy" decoding="async" />
            </a>
            <div class="body">
              <p class="label">{c.lever}</p>
              <h3 class="heading card-title">{c.title}</h3>
              {c.paras.map((p) => <p class="summary">{p}</p>)}
              <p class="label ev-gap">Evidence</p>
              <p class="evidence">{c.evidence}</p>
              <a class="artifact link-gap" href={c.href}>
                {c.link} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </section>
    ))
  }

  <section class="shell closing">
    <h2 class="heading">The outcome was not a louder design function</h2>
    <p>It was a more useful one.</p>
    <p>
      Design earned influence because it made opportunities clearer, scope more
      defensible, execution more coherent, and the people doing the work more
      capable.
    </p>
    <p>
      The business-value models changed how investments were framed. The
      complexity budget changed how scope was negotiated. The design system gave
      teams a shared foundation. The delivery threshold clarified when to
      challenge and when to commit. The role and career models developed
      designers who could operate across all of it.
    </p>
    <p>
      I do not measure leadership by how many decisions depend on me. I measure
      it by whether the team can frame the problem, challenge the scope, hold the
      standard, and influence direction without waiting for permission.
    </p>
    <p class="close-line">
      I scale design by improving the decisions the team is equipped to make.
    </p>
  </section>
</BaseLayout>

<style>
  /*
   * This page runs on the design system. From global.css: .shell, .label,
   * .heading, .artifact, the type tokens (--text-lede, --text-note, --text-h2,
   * --text-h3) and the surface tokens. The Display component sizes the H1.
   *
   * Three things had no system equivalent and are declared here as new:
   *
   *   1. hero-cap    — a page-level ceiling on the fitted display size, so the
   *                    statement and the three framing cards share a viewport.
   *   2. the card surface — white, 10px radius, no border. This is the embed
   *                    card treatment reused as a general surface (.frames li,
   *                    .media); candidate for promotion into global.css.
   *   3. .evidence   — a bold ink line at note size for a named result; also
   *                    carries the closing line.
   *
   * Everything else is composition: grid, gap, max-width, margins.
   */
  .hero {
    padding-top: 96px;
  }

  .hero-cap :global(.display) {
    font-size: min(64px, 5vw) !important;
  }

  .open {
    margin: 26px 0 0;
    max-width: 64ch;
    font-size: var(--text-lede);
    line-height: 1.45;
    color: var(--color-ink);
  }

  .open.dim {
    margin-top: 16px;
    font-size: var(--text-note);
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .frames {
    list-style: none;
    display: grid;
    gap: 14px;
    margin: 44px 0 0;
    padding: 0;
  }

  .frames li {
    background: var(--color-paper-raised);
    border-radius: 10px;
    padding: 24px 22px;
  }

  .frame-name {
    margin: 0;
    font-size: var(--text-h3);
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .frame-what {
    margin: 8px 0 0;
    font-size: var(--text-caption);
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  .block {
    padding-top: 110px;
  }

  .statement {
    font-size: var(--text-h2);
    margin: 10px 0 0;
    max-width: 30ch;
  }

  .sec-intro {
    margin: 16px 0 0;
    max-width: 64ch;
    font-size: var(--text-note);
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .card {
    display: grid;
    gap: 26px;
    margin-top: 56px;
  }

  .media {
    display: block;
    background: var(--color-paper-raised);
    border-radius: 10px;
    overflow: hidden;
    padding: 22px;
    align-self: start;
  }

  .media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .card-title {
    font-size: var(--text-h3);
    margin: 8px 0 0;
  }

  .summary {
    margin: 12px 0 0;
    font-size: var(--text-note);
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .ev-gap {
    margin-top: 18px;
  }

  .evidence {
    margin: 4px 0 0;
    font-size: var(--text-note);
    line-height: 1.5;
    font-weight: 600;
    color: var(--color-ink);
  }

  .link-gap {
    margin-top: 18px;
  }

  .closing {
    padding-top: 120px;
    padding-bottom: 40px;
  }

  .closing h2 {
    font-size: var(--text-h2);
    margin: 0 0 18px;
    max-width: 30ch;
  }

  .closing p {
    max-width: 66ch;
    margin: 0 0 16px;
    font-size: var(--text-note);
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .close-line {
    font-size: var(--text-note);
    font-weight: 600;
    color: var(--color-ink) !important;
    margin-top: 26px !important;
  }

  @media (min-width: 860px) {
    .frames {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Uniform: the case reads first, the diagram sits right, every card. */
    .card {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 48px;
      align-items: start;
    }

    .media {
      order: 2;
    }
  }
</style>

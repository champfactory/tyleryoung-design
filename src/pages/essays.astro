---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';

/**
 * Three dimensions of the work, equal in weight — related, not sequential, so
 * nothing here draws an arrow between them.
 */
const frames = [
  ['Planning', 'Decide what is worth building before the roadmap hardens.'],
  ['Standards', 'Keep quality consistent without me in every review.'],
  ['People', 'Grow designers who can own a problem end to end.'],
];

const sections = [
  {
    label: 'Planning',
    statement: 'I put design into the decision, not just the delivery',
    cards: [
      {
        title: 'I translated design into business terms',
        paras: [
          'Design proposals were being read as visual improvements because nobody had priced their value. Working with product leadership, I built a taxonomy of design work, mapped it to company metrics, and wrote a rubric that weighed user value, business value, effort and risk in the same conversation.',
        ],
        evidence: 'Executives started using the design levers in funding meetings.',
        link: 'Three models that tied design to business metrics',
        href: '/how-i-translated-design-work',
        fig: '/work/essays/how-i-translated-design-work/fig-2.svg',
        alt: 'Two-by-two placing the four business levers: efficiency in operation and now, growth in operation and future, retention in customer and now, strategic alignment in customer and future.',
      },
      {
        title: 'I made complexity a scoping constraint',
        paras: [
          'Everyone agreed simplicity mattered, but nobody had a way to defend it. The complexity budget scored each flow on decision, attention and orientation load, which gave product, research, design and engineering a shared way to see where scope was asking too much of users and cut it before it reached the interface.',
        ],
        evidence: 'Complexity stopped being something to polish and became a cost to justify.',
        link: 'A complexity budget for scope decisions',
        href: '/how-i-managed-ux-complexity',
        fig: '/work/essays/how-i-managed-ux-complexity/fig-2.svg',
        alt: 'Heat map scoring four product flows against decision, attention and orientation load on the easy, manageable, challenging, frustrating scale, the heaviest cells shaded darkest.',
        legend: 'E easy · M manageable · C challenging · F frustrating',
      },
    ],
  },
  {
    label: 'Standards',
    statement: 'I made quality something other teams could rely on',
    cards: [
      {
        title: 'I built a design system five functions chose to use',
        paras: [
          'Quality was drifting across siloed teams, conflicting standards and repeated handoff failures, so I led a system of more than 200 components that connected product, engineering, creative, marketing and planning. Nobody was ordered to use it — product managers learned it, engineering mirrored it, and teams began planning around it.',
        ],
        evidence: 'A design project became infrastructure that five functions rely on.',
        link: 'A design system five functions chose to adopt',
        href: '/how-i-scaled-design-efficiency',
        fig: '/work/essays/how-i-scaled-design-efficiency/fig-1.svg',
        alt: 'Three layers of design-system trust: shared language produces alignment, shared structure produces consistency, shared infrastructure produces velocity.',
      },
      {
        title: 'I made “good enough” a deliberate threshold',
        paras: [
          'Teams were rushing through problem definition and then polishing execution forever, so I flipped the standard: exceed the bar while you are defining the problem, and defend “good enough” once the work has done its job.',
        ],
        evidence: 'The team got more rigorous up front and stopped sooner at the end.',
        link: 'Knowing when to stop building',
        href: '/how-i-built-culture-around-paradox',
        fig: '/work/essays/how-i-built-culture-around-paradox/fig-1.svg',
        alt: 'Before and after table on team decision maturity: problem framing, alignment on success and knowing when to stop each move from implicit to deliberate.',
      },
    ],
  },
  {
    label: 'People',
    statement: 'I developed designers to own more than execution',
    cards: [
      {
        title: 'I rebuilt specialist roles around product ownership',
        paras: [
          'After the pandemic shrank the team, a structure built on handoffs between UX and visual specialists was too brittle for the pace of the work. I rebuilt the group around junior product-design generalists and coached them to own everything from first framing to final delivery.',
        ],
        evidence: 'Junior designers delivered what senior specialists once had, faster and with fewer dependencies, then grew into planning and mentorship.',
        link: 'Rebuilding the team from specialists to generalists',
        href: '/how-i-unlocked-team-trust',
        fig: '/work/essays/how-i-unlocked-team-trust/fig-1.svg',
        alt: 'Before and after diagram of the team’s shape: separate specialist groups become one ring of product-design generalists around the product.',
      },
      {
        title: 'I rewarded influence, not just output',
        paras: [
          'The career path rewarded execution, which kept capable designers out of strategic conversations. I made problem framing, recommendations, influence and mentorship count toward advancement, and gave designers room to practice them in roadmap and tradeoff meetings rather than only in critique.',
        ],
        evidence: 'Designers advanced by shaping direction, not by shipping more.',
        link: 'Promoting designers for influence, not output',
        href: '/how-i-shaped-cross-functional-reputation',
        fig: '/work/essays/how-i-shaped-cross-functional-reputation/fig-1.svg',
        alt: 'A five-stage growth loop running from structure to trust to opportunity to visibility to advancement, and back.',
      },
    ],
  },
];
---

<BaseLayout
  title="I build design teams that make better product decisions"
  metaTitle="I build design teams that make better product decisions | Tyler Young"
  description="Most design teams are measured by what they deliver. I built mine to improve the decisions that determine what gets delivered — how opportunities were framed, how complexity was challenged, how quality traveled, and how designers grew."
  current="essays"
>
  <div class="shell hero">
    <PageHead eyebrow="How I lead" title="I build design teams that make better product decisions" />
    <p class="open">
      The tools my team built kept getting adopted outside design. Executives
      used our value levers in funding meetings, five functions built on our
      design system, and junior designers took over problems that used to need
      senior specialists. These six stories explain how, in three parts.
    </p>

    <ul class="frames">
      {
        frames.map(([name, what]) => (
          <li>
            <h2 class="frame-name">{name}</h2>
            <p class="frame-what">{what}</p>
          </li>
        ))
      }
    </ul>
  </div>

  {
    sections.map((sec, si) => (
      <section class="shell block" aria-labelledby={`sec-${si}`}>
        <p class="label">{sec.label}</p>
        <h2 class="heading statement" id={`sec-${si}`}>{sec.statement}</h2>

        {sec.cards.map((c, ci) => (
          <article class="card">
            <a class="media" href={c.href} tabindex="-1" aria-hidden="true">
              <img src={c.fig} alt={c.alt} loading="lazy" decoding="async" />
              {c.legend && <span class="legend">{c.legend}</span>}
            </a>
            <div class="body">
              <h3 class="heading card-title">{c.title}</h3>
              {c.paras.map((p) => <p class="summary">{p}</p>)}
              <p class="evidence">{c.evidence}</p>
              <a class="artifact link-gap" href={c.href}>
                {c.link} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </section>
    ))
  }

</BaseLayout>

<style>
  /*
   * This page runs on the design system. From global.css: .shell, .label,
   * .heading, .artifact, the type tokens (--text-lede, --text-note, --text-h2,
   * --text-h3) and the surface tokens. The Display component sizes the H1.
   *
   * Three things had no system equivalent and are declared here as new:
   *
   *   1. hero-cap    — a page-level ceiling on the fitted display size, so the
   *                    statement and the three framing cards share a viewport.
   *   2. the card surface — white, 10px radius, no border. This is the embed
   *                    card treatment reused as a general surface (.frames li,
   *                    .media); candidate for promotion into global.css.
   *   3. .evidence   — a bold ink line at note size for a named result; also
   *                    carries the closing line.
   *
   * Everything else is composition: grid, gap, max-width, margins.
   */
  .hero {
    padding-top: var(--space-page-top);
  }


  .open {
    margin: 26px 0 0;
    font-size: var(--text-lede);
    line-height: 1.45;
    color: var(--color-ink);
  }

  /* The site's banded row: equal boxes, every other one surfaced. */
  .frames {
    list-style: none;
    display: grid;
    gap: 0;
    margin: 44px 0 0;
    padding: 0;
  }

  .frames li {
    padding: 20px 18px;
  }

  .frames li:nth-child(odd) {
    background: var(--color-row);
  }

  .frame-name {
    margin: 0;
    font-size: var(--text-h3);
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .frame-what {
    margin: 8px 0 0;
    font-size: var(--text-caption);
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  /* Three sections, three clear breaths — the gap between themes has to beat
     the gap between a theme and its own cards by a wide margin. */
  .block {
    padding-top: 170px;
  }

  /* The theme. It spans the measure and sits directly on the gray page — the
     only element at this rank — so the white cards beneath read as its
     contents, not its siblings. */
  .statement {
    font-size: clamp(28px, 3vw, 34px);
    margin: 10px 0 0;
  }


  .card {
    display: grid;
    gap: 26px;
    margin-top: 40px;
    background: var(--color-paper-raised);
    border-radius: 10px;
    padding: 30px 28px;
  }

  .media {
    display: block;
    align-self: center;
  }

  .media img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* A diagram that speaks in letters says what they mean, right under itself. */
  .legend {
    display: block;
    margin-top: 12px;
    text-align: center;
    font-size: 13px;
    color: var(--color-ink-3);
  }

  .card-title {
    font-size: var(--text-h3);
    margin: 0;
  }

  .summary {
    margin: 14px 0 0;
    font-size: var(--text-note);
    line-height: 1.55;
    color: var(--color-ink-2);
  }


  /* The result: paragraph-sized, full ink where the summary is ink-2, leading
     straight into the blue link that completes it. */
  .evidence {
    margin: 10px 0 0;
    font-size: var(--text-note);
    line-height: 1.55;
    color: var(--color-ink);
  }

  .link-gap {
    margin-top: 14px;
  }

  @media (min-width: 860px) {
    .frames {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Uniform: the case reads first, the diagram sits right, every card. */
    .card {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 48px;
      align-items: start;
      padding: 34px 36px;
    }

    .media {
      order: 2;
    }
  }
</style>

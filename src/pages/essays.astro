---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { essayGroups } from '../data/essayGroups';

const essays = await getCollection('essays');
const count = essays.length;
const words = ['zero','one','two','three','four','five','six','seven','eight','nine','ten'];
const spelled = words[count] ?? String(count);
const bySlug = new Map(essays.map((e) => [e.data.slug, e]));

---

<BaseLayout
  title="Leadership essays | Tyler Young"
  description={`${spelled.charAt(0).toUpperCase() + spelled.slice(1)} things I built to run design teams: scoring models, budgets, thresholds and promotion criteria that kept working after I left the room.`}
  current="essays"
>
  <section class="shell page">
    <p class="label">Leadership writing</p>
    <h1 class="display">{spelled.charAt(0).toUpperCase() + spelled.slice(1)} things I built to run design teams</h1>
    <p class="lede">
      Each of these is the same move the work on the homepage makes: take a judgment
      that lived in someone's head and make it explicit enough to survive without
      them. Written years before the thing carrying the judgment was a machine.
    </p>

    <div class="groups">
      {
        essayGroups.map((group, i) => (
          <section class="group" aria-labelledby={`g${i}`}>
            <div class="group-head">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="eyebrow">{group.eyebrow}</p>
                <h2 class="heading" id={`g${i}`}>
                  {group.title}
                </h2>
                {group.blurb && <p class="blurb">{group.blurb}</p>}
              </div>
            </div>

            <ul>
              {group.slugs.map((slug) => {
                const e = bySlug.get(slug);
                return e ? (
                  <li>
                    <a class="link" href={`/${slug}`}>
                      {e.data.title}
                    </a>
                  </li>
                ) : null;
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-top: 88px;
  }

  /* No max-width on either. A 20ch cap broke a six-word headline over three
     lines and left the right half of the page empty; the lede did the same at
     56ch. Both now run the shell's measure, so the block reads as one edge. */
  h1 {
    font-size: clamp(32px, 5.2vw, 52px);
    margin: 16px 0 0;
  }

  .lede {
    margin: 26px 0 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--color-ink-2);
  }

  .groups {
    margin-top: 64px;
    display: grid;
    gap: 52px;
  }

  .group-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    padding-top: 20px;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.09em;
    color: var(--color-signal);
    margin-top: 6px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin: 0 0 6px;
  }

  h2 {
    font-size: 26px;
    margin: 0;
  }

  .blurb {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-ink-3);
  }

  ul {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  /* An index row: one rule per title, running the full column. The rule is what
     fills the measure now that nothing sits opposite the title. */
  li {
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 12px;
  }

  li a.link {
    font-size: 20px;
    line-height: 1.4;
    border-bottom: 0;
  }

  li:hover a.link {
    color: var(--color-signal);
  }



  @media (min-width: 810px) {
    .group {
      display: grid;
      grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
      gap: 40px;
    }

    .group-head {
      border-top: 0;
      padding-top: 0;
    }

    .group {
      padding-top: 20px;
    }

    ul {
      margin-top: 0;
    }
  }
</style>

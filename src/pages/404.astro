---
import BaseLayout from '../layouts/BaseLayout.astro';
import { essayGroups } from '../data/essayGroups';
import { getCollection } from 'astro:content';

const essays = await getCollection('essays');
const bySlug = new Map(essays.map((e) => [e.data.slug, e]));
---

<BaseLayout
  title="Not found | Tyler Young"
  description="That page doesn't exist. Here's everything that does."
>
  <section class="shell notfound">
    <p class="label">404</p>
    <h1 class="display">That page doesn't exist</h1>
    <p class="lede">
      The essay URLs from the previous site were all preserved, so an old link should
      still work. If one doesn't, it's a bug worth telling me about.
    </p>

    <div class="index">
      <div class="col">
        <p class="label">Building with AI</p>
        <ul>
          <li><a class="link" href="/alucify">Designing for AI agents</a></li>
          <li><a class="link" href="/ops-manager">The system and its library</a></li>
          <li><a class="link" href="/review-loop">The review loop</a></li>
          <li><a class="link" href="/how-i-design-with-ai">I design with AI</a></li>
        </ul>

        <p class="label spaced">Elsewhere</p>
        <ul>
          <li><a class="link" href="/">Home</a></li>
          <li><a class="link" href="/tldr">TL;DR</a></li>
          <li><a class="link" href="/colophon">How this site is built</a></li>
        </ul>
      </div>

      <div class="col">
        {
          essayGroups.map((group) => (
            <div class="group">
              <p class="label">{group.eyebrow}</p>
              <ul>
                {group.slugs.map((slug) => {
                  const e = bySlug.get(slug);
                  return e ? (
                    <li>
                      <a class="link" href={`/${slug}`}>
                        {e.data.title}
                      </a>
                    </li>
                  ) : null;
                })}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-top: 72px;
  }

  h1 {
    font-size: var(--text-display);
    margin: 16px 0 0;
  }

  .lede {
    margin: 24px 0 0;
    max-width: 56ch;
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-ink);
  }

  .index {
    margin-top: 56px;
    padding-top: 28px;
    display: grid;
    gap: 40px;
  }

  .spaced {
    margin-top: 28px;
  }

  .group + .group {
    margin-top: 28px;
  }

  ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  li a {
    font-size: var(--text-h3);
    line-height: 1.4;
  }

  @media (min-width: 810px) {
    .index {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: 64px;
    }
  }
</style>

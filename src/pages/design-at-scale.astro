---
import DocumentLayout from '../layouts/DocumentLayout.astro';
import LeadStrand from '../components/LeadStrand.astro';
import Needs from '../components/Needs.astro';

/**
 * DELIBERATELY THIN.
 *
 * An earlier version of this page invented a timeline, a count of adopting orgs,
 * and a thesis about the cost of variation, then attributed the lot to Tyler. It
 * also assumed the design-system essay and the CaaStle decks describe the same
 * engagement — nothing in the source says that.
 *
 * What survives here is only what appears in Tyler's own essay text, quoted. The
 * connective tissue is his to supply.
 */

// Verbatim from how-i-scaled-design-efficiency.
const quotes = [
  'I led the creation of a global design system used across five business functions and more than 200 components. It wasn’t just a visual library; it was a systematic operating layer embedded in the design and engineering workflow.',
  'Adoption didn’t come through mandates. It spread through usefulness. Product managers began learning the system to guide handoff conversations more confidently.',
  'At the same time, creative and marketing teams adopted system components to accelerate asset production and campaign execution. As more teams used it in their workflows, the system became a shared language and a standard of trust.',
  'For the first time, leadership reviewed rapid prototyped concepts that mirrored final implementation.',
];

// Ported verbatim from the live site, including the deck URLs.
const surfaces = [
  {
    eyebrow: 'Execution Impact',
    title: 'Fast Find',
    desc: 'Replaced filters with expressive inputs. A new UX primitive, built to move faster.',
    label: '14 slide deck',
    href: 'https://www.figma.com/deck/UBBOP8SP5gITdCrqp3jrty/Fast-Find?node-id=4004-207&viewport=501%2C404%2C0.02&t=jGlUNHd3GRNmvQiM-1&scaling=min-zoom&content-scaling=fixed&page-id=0%3A1',
  },
  {
    eyebrow: 'Strategic Framing',
    title: 'One Place',
    desc: 'Built conversion UX around perceived proximity to referring site, not just friction.',
    label: '14 slide deck',
    href: 'https://www.figma.com/deck/ToCiSMjR0JI9Y0SoDsBlNC/One-Place?node-id=4004-207&viewport=-63%2C38%2C0.49&t=WBw66U8AtUSdKLG5-1&scaling=min-zoom&content-scaling=fixed&page-id=0%3A1',
  },
  {
    eyebrow: 'System Design',
    title: 'Storefront Builder',
    desc: 'Created safe levers for brand expression. Control and creativity, finally in sync.',
    label: '15 slide deck',
    href: 'https://www.figma.com/deck/TxWswaxL97AiA48NWD9e5s/Storefront-Builder?node-id=2005-2&viewport=-42%2C52%2C0.47&t=Chg8rwuX9we4PeCk-1&scaling=min-zoom&content-scaling=fixed&page-id=0%3A1',
  },
];
---

<DocumentLayout
  title="A design system adopted through usefulness, not mandate"
  metaTitle="Design at organisational scale | Tyler Young"
  description="A global design system across five business functions and more than 200 components, adopted through usefulness rather than mandate."
  descriptionDraft
  eyebrow="03 · Organisational Scale"
  meta={[
    ['Scope', 'Five business functions · 200+ components'],
    ['Company', '[NEEDS: which employer, and whether it can be named]'],
    ['When', '[NEEDS: years — the essays carry no dates]'],
    ['Role', '[NEEDS: title at the time]'],
  ]}
>
  <div class="aside">
    <p>
      This page is a skeleton on purpose. Everything below is quoted from Tyler's
      own essay; nothing has been paraphrased into a narrative he did not write.
      The framing that turns it into a story is his to supply.
    </p>
  </div>

  <p class="answer">
    <Needs>
      the claim for this story, in Tyler's words. Something in the register of the
      other two: first person, specific, falsifiable.
    </Needs>
  </p>

  <h2>What the essay actually says</h2>

  <div class="quotes">
    {quotes.map((q) => <blockquote>{q}</blockquote>)}
  </div>

  <p class="src">
    Source: <a href="/how-i-scaled-design-efficiency">How I scaled design efficiency</a>
  </p>

  <h2>Open questions before this becomes a story</h2>
  <ul>
    <li>
      <Needs>
        Is the design system above the same engagement as the three product
        surfaces below? Nothing in the source connects them — that was my assumption
      </Needs>
    </li>
    <li>
      <Needs>
        What the system changed that the essay does not already say — the outcome
        worth leading with
      </Needs>
    </li>
    <li>
      <Needs>
        Whether this story is organisational scale, or something else entirely
      </Needs>
    </li>
  </ul>

  <h2>Product surfaces</h2>
  <p class="sub">
    Three surfaces, ported from the current site with their decks. Attribution per
    the project brief; the connection to the design system above is unverified.
  </p>

  <div class="surfaces">
    {
      surfaces.map((s) => (
        <article class="surface">
          <p class="eyebrow">{s.eyebrow}</p>
          <h3 class="heading">{s.title}</h3>
          <p class="desc">{s.desc}</p>
          <a class="artifact" href={s.href} target="_blank" rel="noopener">
            {s.label}
            <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>

  <LeadStrand
    slot="after"
    items={[
      {
        slug: 'how-i-scaled-design-efficiency',
        note: 'The full essay this page quotes — including how adoption spread through usefulness rather than mandate, and how the system became the default starting point for project planning.',
      },
      {
        slug: 'how-i-shaped-cross-functional-reputation',
        note: 'Written about the same kind of organisational work: tying advancement to planning impact, and what that changed about how the rest of the company treated design.',
      },
    ]}
  />
</DocumentLayout>

<style>
  .answer {
    font-size: 20px !important;
    line-height: 1.55 !important;
    margin-bottom: 36px !important;
  }

  .quotes {
    display: grid;
    gap: 20px;
    margin: 0 0 18px;
  }

  blockquote {
    margin: 0;
    padding: 16px 20px;
    background: var(--color-paper-sunk);
    border-left: 2px solid var(--color-rule-strong);
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  .src {
    font-family: var(--font-mono);
    font-size: 11px !important;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin: 0 0 10px !important;
  }

  .sub {
    font-size: 17px !important;
    color: var(--color-ink-2);
  }

  .surfaces {
    display: grid;
    gap: 28px;
    margin: 26px 0 34px;
  }

  .surface {
    padding-top: 18px;
    border-top: 1px solid var(--color-rule);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-signal);
    margin: 0 0 8px !important;
  }

  .surface h3 {
    font-size: 24px;
    margin: 0 0 8px !important;
  }

  .desc {
    font-size: 17px !important;
    line-height: 1.55 !important;
    color: var(--color-ink-2);
    margin: 0 0 16px !important;
    max-width: 44ch;
  }

  @media (min-width: 810px) {
    .surfaces {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
  }
</style>

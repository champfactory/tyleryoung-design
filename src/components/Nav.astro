---
const { current } = Astro.props as { current?: string };
---

<header class="nav">
  <div class="shell inner">
    <a class="wordmark" href="/">
      <span class="name">Tyler Young</span>
      <span class="role">Senior Director of Design</span>
    </a>
    <nav aria-label="Main">
      {/* One sentence, not a row of tabs. The connective words are plain ink, so
          only the two things you can go and do are blue. The email lives in the
          footer of every page — it was the widest thing in the header, spending
          the best slot on the least differentiated fact. */}
      <p class="statement">
        I <a href="/how-i-design-with-ai" aria-current={current === 'building' ? 'page' : undefined}
          >design with AI</a
        > and <a href="/essays" aria-current={current === 'essays' ? 'page' : undefined}
          >lead teams</a
        >.
      </p>
    </nav>
  </div>
</header>

<style>
  .nav {
    /* Translucent over a blur. A tint alone was tried and reverted — a flat
       colour at partial opacity over scrolling content goes muddy — but the
       blur is what fixes that: it removes the detail underneath and leaves an
       even field, which is why every implementation of this ships the two
       together and none ships the tint alone.

       Derived from paper — the page ground — rather than given its own value.
       That is what makes the top overscroll invisible: the canvas on <html> is
       the same token, so 72% of the ground blurred over the ground is the
       ground, and the strip revealed above the nav matches the nav exactly. */
    background: color-mix(in srgb, var(--color-paper) 72%, transparent);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  /* Firefox before 103 and anything with the filter disabled gets the flat
     surface rather than a see-through bar over live text. */
  @supports not (backdrop-filter: blur(1px)) {
    .nav {
      background: var(--color-paper);
    }
  }


  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 20px;
  }

  .wordmark {
    display: flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
    color: var(--color-ink);
    flex-wrap: wrap;
  }

  .name {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.015em;
  }

  .role {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.015em;
    color: var(--color-ink);
  }

  ul {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Sentence case, because it is a sentence — the uppercase treatment belonged
     to tabs. The type sits on `nav` rather than on the paragraph's class: as a
     class it lost to `nav a` for the links and left the connective words
     inheriting 19px body sans, so the sentence rendered at two sizes. */
  nav {
    font-family: var(--font-mono);
    font-size: 15px;
    /* 400, matching .role beside it. The wordmark's name is 600 and carries the
       emphasis; the role and this sentence are the same rank and were reading
       at two different weights on one line. */
    font-weight: 400;
    letter-spacing: 0.015em;
    color: var(--color-ink);
  }

  /* Wraps on a narrow screen. Held on one line it is wider than a 390px
     viewport, which pushed the whole document sideways — the header cannot be
     the reason a page scrolls horizontally. */
  .statement {
    margin: 0;
  }

  @media (min-width: 760px) {
    .statement {
      white-space: nowrap;
    }
  }

  nav a {
    font: inherit;
    letter-spacing: inherit;
    /* Underlined at rest, not only on hover. These are the only links on the
       site that live outside prose, so they have no surrounding sentence to
       mark them as links — hover-only meant a reader had to point at the
       sentence to find out which words were live. */
    text-decoration: underline;
    text-underline-offset: 3px;
    padding-bottom: 2px;
    /* The page you are on reads in plain ink. */
    color: var(--color-signal);
    transition: opacity 120ms ease;
  }

  nav a[aria-current='page'] {
    color: var(--color-ink);
  }

  .inner {
    min-width: 0;
  }

  .wordmark,
  nav {
    min-width: 0;
  }

  /* At 390px the wordmark + three links measure wider than the viewport, which
     pushes the whole document's scrollWidth past the screen. The role line goes
     first (it's a nicety, not information), then the type tightens. */
  @media (max-width: 560px) {
    .role {
      display: none;
    }

    .name {
      font-size: 15px;
      letter-spacing: 0.015em;
    }

    nav a {
      font-size: 15px;
      letter-spacing: 0.015em;
    }

    ul {
      gap: 13px;
    }

    .inner {
      gap: 12px;
    }
  }
</style>

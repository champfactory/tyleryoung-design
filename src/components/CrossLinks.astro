---
interface Props {
  title: string;
  label?: string;
  links: { href: string; label: string }[];
}
const { title, label = 'More in this group', links } = Astro.props;
---

{
  links.length > 0 && (
    <nav class="shell crosslinks" aria-labelledby="crosslinks-title">
      <p class="label">{label}</p>
      <h2 class="heading" id="crosslinks-title">
        {title}
      </h2>
      <ul>
        {links.map((l) => (
          <li>
            <a class="link" href={l.href}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  /* The same two columns the document uses, with the rail column left empty,
     so this block starts exactly where the prose does. It used to sit at the
     shell edge — 80px against the prose at 380 — because it renders outside
     `.columns`. Matching the grid rather than hardcoding an offset means it
     cannot drift when the rail or the gap changes. */
  .crosslinks {
    margin-top: 96px;
    padding-top: 20px;
  }

  @media (min-width: 810px) {
    .crosslinks {
      display: grid;
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 56px;
    }

    .crosslinks > * {
      grid-column: 2;
    }
  }

  @media (min-width: 1200px) {
    .crosslinks {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 80px;
    }
  }

  h2 {
    font-size: 30px;
    margin: 8px 0 22px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
    max-width: 70ch;
  }

  a {
    font-size: 20px;
    line-height: 1.4;
  }
</style>

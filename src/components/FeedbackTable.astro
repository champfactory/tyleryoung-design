---
/**
 * All forty-eight notes, coloured by what happened to them.
 *
 * Status is by surface, because that is what the diff proves: four of the six
 * surfaces had their files changed in the next version, two did not. Within a
 * reworked surface not every individual note necessarily landed — the caption
 * says so rather than implying a per-item guarantee the evidence doesn't support.
 */
import items from '../data/feedback.json';

/** Surfaces whose component files changed between the two builds. */
const REWORKED = new Set(['Overall Body', 'Home', 'Jobs', 'AiR Sessions']);

const ORDER = ['Home', 'Jobs', 'AiR Sessions', 'Overall Body', 'Ask OASES', 'Top Nav'];
const FILES: Record<string, string> = {
  'Home': 'App.jsx',
  'Jobs': 'JobsPage.jsx',
  'AiR Sessions': 'SessionsPage · PastSessionsPage',
  'Overall Body': 'App.jsx',
  'Ask OASES': 'AiResponse · Drawer — untouched',
  'Top Nav': 'NavModal · NavRight — untouched',
};

const grouped = ORDER.map((surface) => ({
  surface,
  reworked: REWORKED.has(surface),
  file: FILES[surface],
  notes: items.filter((i: { surface: string }) => i.surface === surface),
})).filter((g) => g.notes.length);

const done = items.filter((i: { surface: string }) => REWORKED.has(i.surface)).length;
---

<figure class="table">
  <div class="head">
    <span class="key">
      <span class="swatch on" aria-hidden="true"></span>
      {done} addressed
    </span>
    <span class="key">
      <span class="swatch off" aria-hidden="true"></span>
      {items.length - done} not this round
    </span>
  </div>

  {
    grouped.map((g) => (
      <section class:list={['group', { off: !g.reworked }]}>
        <p class="surface">
          <span class="name">{g.surface}</span>
          <span class="file">{g.file}</span>
          <span class="count">{g.notes.length}</span>
        </p>
        <ul>
          {g.notes.map((n: { note: string }) => (
            <li>
              <span class="dot" aria-hidden="true"></span>
              {n.note}
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <figcaption>
    Status is by surface, taken from the diff between the two builds — four had
    their files changed, two did not. Within a reworked surface not every note
    necessarily landed; the collapsible rows asked for on Home are an example that
    did not.
  </figcaption>
</figure>

<style>
  /* No card. This lives inside a Sheet, which is the card — an outlined,
     rounded, white box inside an outlined, rounded, white box was two frames
     saying one thing. */
  .table {
    margin: 0;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: 0 0 6px;
    padding: 10px 12px;
    border-radius: var(--radius-inset);
    background: var(--color-band-a);
  }

  .key {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-ink);
  }

  /* The same two marks the gated framework uses: filled for a note that
     landed, hollow for one that did not. They were blue and grey squares —
     blue is the link colour on this site and nothing else, so a blue square
     beside a piece of status was reading as an affordance that wasn't there. */
  .swatch,
  .dot {
    flex: none;
    background: currentColor;
    -webkit-mask: var(--mark-bullet) center / contain no-repeat;
    mask: var(--mark-bullet) center / contain no-repeat;
  }

  .swatch {
    width: 11px;
    height: 11px;
    color: var(--color-ink);
  }

  .swatch.off {
    -webkit-mask-image: var(--mark-hollow);
    mask-image: var(--mark-hollow);
    color: var(--color-ink-3);
  }

  .group + .group {
    margin-top: 22px;
  }

  /* Sticky, so the surface a note belongs to is still on screen when its
     seventeenth note is. The white behind it is the sheet's own. */
  .surface {
    position: sticky;
    top: -1px;
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 !important;
    padding: 14px 0 10px;
    background: var(--color-paper-raised);
    font-family: var(--font-mono) !important;
    font-size: 11px !important;
    letter-spacing: 0;
  }

  .name {
    font-weight: 600;
    color: var(--color-ink);
  }

  .file {
    color: var(--color-ink-3);
  }

  .count {
    margin-left: auto;
    color: var(--color-ink-3);
  }

  ul {
    list-style: none;
    display: grid;
    gap: 2px;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Banded, like every other row list on the site, so forty-eight lines of
     similar length stay countable. */
  li {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    padding: 9px 12px;
    background: var(--color-band-b);
    font-family: var(--font-mono) !important;
    font-size: 13px !important;
    line-height: 1.55 !important;
    letter-spacing: 0;
    color: var(--color-ink) !important;
    text-wrap: pretty;
  }

  li:nth-child(odd) {
    background: var(--color-band-a);
  }

  .group ul {
    border-radius: var(--radius-inset);
    overflow: hidden;
  }

  li::before {
    content: none !important;
  }

  .dot {
    width: 9px;
    height: 9px;
    margin-top: 6px;
    color: var(--color-ink);
  }

  .off .dot {
    -webkit-mask-image: var(--mark-hollow);
    mask-image: var(--mark-hollow);
    color: var(--color-ink-3);
  }

  .off .name,
  .off li {
    color: var(--color-ink-3) !important;
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    letter-spacing: 0;
    color: var(--color-ink-3);
    margin: 22px 0 0;
    padding: 0;
  }
</style>

---
/**
 * Embeds a live deployment, scaled to fit its container exactly.
 *
 * The iframe is sized as a *percentage of the container* — width: 100/scale% —
 * then transform-scaled back down. That way the scaled result is always exactly
 * the container's width, whatever that turns out to be. Sizing the iframe at a
 * fixed pixel width and scaling by a fixed factor (the previous approach) only
 * lines up at one container width and leaves dead space at every other.
 *
 * The consequence worth knowing: the embedded page believes its viewport is
 * container ÷ scale wide. At scale 0.5 in a 700px column that is 1400px, so the
 * site inside renders its desktop layout rather than a squeezed mobile one.
 *
 * Not a screenshot: if the deployment goes down, this goes blank — the correct
 * failure mode for something presented as evidence.
 *
 * Two things suppress the app's scrollbars, because they are two different
 * scrollbars. scrolling="no" stops the *document* scrolling, which also pins the
 * app to the top of its layout. But the app's main region is its own scroll
 * container, and its bars sit at that element's edges where scrolling="no"
 * cannot reach — so the iframe is also overscanned by OVERSCAN logical pixels in
 * each axis, pushing those edges past the clip. Nothing usable is lost: the
 * frame is pointer-events:none, so the bars were never draggable, and the only
 * content hidden is the strip the bars themselves occupied.
 */
interface Props {
  src: string;
  host: string;
  title: string;
  /** displayed aspect ratio of the frame */
  ratio?: string;
  /**
   * Smaller = wider logical viewport inside the frame.
   *
   * The embedded apps lay out for ~1512px. Logical width is container ÷ scale,
   * so the scale has to be low enough that the narrowest container still clears
   * that — otherwise the right-hand column is simply cut off. A story card at a
   * 1440px window is roughly 660px, and 660 ÷ 0.42 ≈ 1570.
   */
  scale?: number;
  note?: string;
  /** the first embed on a page loads eagerly; everything below it waits */
  eager?: boolean;
}

const { src, host, title, ratio = '16 / 10', scale = 0.42, note, eager = false } = Astro.props;
const pct = `${100 / scale}%`;
/**
 * Logical px trimmed off each edge to hide the app's own scrollbars.
 *
 * Asymmetric on purpose. The bottom takes 40px, which removes the horizontal bar
 * completely and costs nothing — no content sits along that edge.
 *
 * The right takes nothing. The app's inner scroll container is inset from the
 * viewport, so widening the iframe drags the container and its bar along with it;
 * measured at 12, 20 and 28 the bar narrows but never clears, and any crop large
 * enough to clear it also eats the user-profile block, which is flush right.
 * Clipped text is the worse defect, so the bar stays.
 */
const OVERSCAN_X = 0;
const OVERSCAN_Y = 40;
const dimX = `calc(${pct} + ${OVERSCAN_X}px)`;
const dimY = `calc(${pct} + ${OVERSCAN_Y}px)`;
---

<figure class="live">
  <div class="chrome">
    <span class="dot" aria-hidden="true"></span>
    <span class="host">{host}</span>
    <a class="open" href={src} target="_blank" rel="noopener">
      Open <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="viewport" style={`aspect-ratio:${ratio}`}>
    <iframe
      src={src}
      title={title}
      loading={eager ? 'eager' : 'lazy'}
      referrerpolicy="no-referrer"
      scrolling="no"
      style={`width:${dimX};height:${dimY};transform:scale(${scale});`}
    ></iframe>
  </div>

  {note && <figcaption>{note}</figcaption>}
</figure>

<style>
  .live {
    /* Matches StoryFrame. At margin 0 the next paragraph butted straight into the
       caption; on the homepage the card grid owns the gap, so the margin there is
       zeroed by the parent rather than left to chance. */
    /* Same token as every other embed. These two carried `margin: 0 0 34px` —
       no space above at all — so a running screen started immediately under the
       paragraph introducing it while the reconstructions had room on both
       sides. */
    margin: var(--space-embed) 0 calc(var(--space-embed) + 12px);
    border: 1px solid var(--color-rule);
    background: var(--color-paper-raised);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-live);
    flex: none;
  }

  .host {
    color: var(--color-ink);
  }

  .open {
    margin-left: auto;
    color: var(--color-ink);
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule-strong);
    padding-bottom: 1px;
    transition: color 120ms ease, border-color 120ms ease;
  }

  .open:hover {
    color: var(--color-signal);
    border-bottom-color: var(--color-signal);
  }

  .viewport {
    position: relative;
    overflow: hidden;
    background: #ffffff;
  }

  iframe {
    position: absolute;
    top: 0;
    left: 0;
    border: 0;
    transform-origin: top left;
    /* Decorative preview — the adjacent link is the real affordance. */
    pointer-events: none;
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.7;
    letter-spacing: 0.03em;
    color: var(--color-ink-3);
    padding: 12px 14px;
    border-top: 1px solid var(--color-rule);
  }
</style>

---
/**
 * Embeds a live deployment, scaled to fit its container exactly.
 *
 * The iframe is sized as a *percentage of the container* — width: 100/scale% —
 * then transform-scaled back down. That way the scaled result is always exactly
 * the container's width, whatever that turns out to be. Sizing the iframe at a
 * fixed pixel width and scaling by a fixed factor (the previous approach) only
 * lines up at one container width and leaves dead space at every other.
 *
 * The consequence worth knowing: the embedded page believes its viewport is
 * container ÷ scale wide. At scale 0.5 in a 700px column that is 1400px, so the
 * site inside renders its desktop layout rather than a squeezed mobile one.
 *
 * Not a screenshot: if the deployment goes down, this goes blank — the correct
 * failure mode for something presented as evidence.
 *
 * scrolling="no" because the embedded app draws its own scrollbars, and at this
 * scale they render as stray bars along two edges of the specimen. Nothing is
 * lost by suppressing them: the frame is pointer-events:none, so they were never
 * usable — the adjacent link is how you actually get into the app.
 */
interface Props {
  src: string;
  host: string;
  title: string;
  /** displayed aspect ratio of the frame */
  ratio?: string;
  /**
   * Smaller = wider logical viewport inside the frame.
   *
   * The embedded apps lay out for ~1512px. Logical width is container ÷ scale,
   * so the scale has to be low enough that the narrowest container still clears
   * that — otherwise the right-hand column is simply cut off. A story card at a
   * 1440px window is roughly 660px, and 660 ÷ 0.42 ≈ 1570.
   */
  scale?: number;
  note?: string;
}

const { src, host, title, ratio = '16 / 10', scale = 0.42, note } = Astro.props;
const pct = `${100 / scale}%`;
---

<figure class="live">
  <div class="chrome">
    <span class="dot" aria-hidden="true"></span>
    <span class="host">{host}</span>
    <a class="open" href={src} target="_blank" rel="noopener">
      Open <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="viewport" style={`aspect-ratio:${ratio}`}>
    <iframe
      src={src}
      title={title}
      loading="lazy"
      referrerpolicy="no-referrer"
      scrolling="no"
      style={`width:${pct};height:${pct};transform:scale(${scale});`}
    ></iframe>
  </div>

  {note && <figcaption>{note}</figcaption>}
</figure>

<style>
  .live {
    margin: 0;
    border: 1px solid var(--color-rule);
    background: var(--color-paper-raised);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-live);
    flex: none;
  }

  .host {
    color: var(--color-ink-2);
  }

  .open {
    margin-left: auto;
    color: var(--color-ink-2);
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule-strong);
    padding-bottom: 1px;
    transition: color 120ms ease, border-color 120ms ease;
  }

  .open:hover {
    color: var(--color-signal);
    border-bottom-color: var(--color-signal);
  }

  .viewport {
    position: relative;
    overflow: hidden;
    background: #ffffff;
  }

  iframe {
    position: absolute;
    top: 0;
    left: 0;
    border: 0;
    transform-origin: top left;
    /* Decorative preview — the adjacent link is the real affordance. */
    pointer-events: none;
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.7;
    letter-spacing: 0.03em;
    color: var(--color-ink-3);
    padding: 12px 14px;
    border-top: 1px solid var(--color-rule);
  }
</style>

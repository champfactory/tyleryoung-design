---
/**
 * The through-line strand.
 *
 * NOT titled "what it took to lead." That framing separates leadership from the
 * work and invites a reader to file the candidate under a role they may not be
 * hiring for. These essays describe the same move the work above describes —
 * making a judgment explicit so it holds without you in the room — done a decade
 * earlier, when the thing carrying the judgment was a team rather than a machine.
 *
 * So it reads as continuity of practice, not as a claim on a title.
 */
import { getCollection } from 'astro:content';
import Draft from './Draft.astro';

interface Props {
  /** essay slug → my one-line note on why it belongs to this story (draft copy) */
  items: { slug: string; note: string }[];
}
const { items } = Astro.props;

const essays = await getCollection('essays');
const bySlug = new Map(essays.map((e) => [e.data.slug, e]));
---

<section class="strand" aria-labelledby="strand-title">
  <p class="label">Where this comes from</p>
  <h2 class="heading" id="strand-title">The same move, before the machine</h2>

  <div class="items">
    {
      items.map(({ slug, note }) => {
        const e = bySlug.get(slug);
        if (!e) return null;
        return (
          <article class="item">
            <p class="note">
              <Draft>{note}</Draft>
            </p>
            <a class="artifact" href={`/${slug}`}>
              {e.data.title}
              <span aria-hidden="true">→</span>
            </a>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .strand {
    max-width: var(--breakpoint-lg);
    margin: 96px auto 0;
    padding: 28px 20px 0;
  }

  h2 {
    font-size: clamp(26px, 3.4vw, 34px);
    margin: 8px 0 0;
    max-width: 22ch;
  }

  .items {
    margin-top: 36px;
    display: grid;
    gap: 34px;
  }

  .item {
    padding-top: 20px;
  }

  .note {
    margin: 0 0 18px;
    font-size: 19px;
    line-height: 1.58;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  @media (min-width: 810px) {
    .strand {
      padding-inline: 40px;
    }

    .items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px;
    }
  }
</style>

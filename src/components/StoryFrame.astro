---
import Chevron from './Chevron.astro';
/**
 * Embeds a single component from the live Storybook, without Storybook's chrome.
 *
 * The point is that this is not a screenshot — it is the actual component from the
 * actual deployed build, rendering now. If the library breaks, this breaks, which
 * is the correct behaviour for evidence.
 *
 * Lazy-loaded so the page's own first paint is unaffected, and the caption always
 * carries a direct link in case a browser blocks third-party frames.
 */
const SB = 'https://atheer-next-storybook.fly.dev';

interface Props {
  /** Storybook story id, e.g. components-sidebar--default */
  id: string;
  label: string;
  /** Where the component came from in the design file */
  source?: string;
  note?: string;
  height?: number;
}

const { id, label, source, note, height = 520 } = Astro.props;
/**
 * The white boundary inside the viewport, so a specimen has the same margin on
 * all four sides. `height` is the story's own content height; this is added to
 * it rather than taken out of it.
 */
const PAD = 20;

const src = `${SB}/iframe.html?id=${id}&viewMode=story`;
const deepLink = `${SB}/?path=/story/${id}`;
---

<figure class="story-frame">
  <div class="chrome">
    <span class="name">{label}</span>
    {source && <span class="source">{source}</span>}
    <a class="open" href={deepLink} target="_blank" rel="noopener">
      Open in library<Chevron weight="bold" />
    </a>
  </div>

  <div class="viewport" style={`height:${height + PAD * 2}px`}>
    <iframe
      src={src}
      title={`${label} — live from the component library`}
      loading="lazy"
      referrerpolicy="no-referrer"
      scrolling="no"
    ></iframe>
  </div>

  {note && <figcaption class="evidence-foot">{note}</figcaption>}
</figure>

<style>
  .story-frame {
    /* Same token as every other embed. These two carried `margin: 0 0 34px` —
       no space above at all — so a running screen started immediately under the
       paragraph introducing it while the reconstructions had room on both
       sides. */
    margin: var(--space-embed) 0 calc(var(--space-embed) + 12px);
    /* The mat, not the card surface. These embeds are screenshots of near-white
       applications. On the light palette they met paper-raised at 1.03:1 and
       their edges disappeared, which is why mount exists. The dark palette does
       not have that problem — white art on mount is a hard edge either way —
       but mount is still the right surface: it is the token that says "framed
       evidence", and the inset below is what gives the frame its margin. */
    background: var(--color-mount);
  
    /* A card, not an outlined panel: small radius, no border, the radius alone. */
    border: 0;
    border-radius: var(--radius-mat);
    overflow: hidden;
  }

  .chrome {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 14px;
    /* No rule under it. The bar and the art are already two surfaces — mat and
       white — so a hairline was a third edge saying what the surfaces said.
       Inline padding matches the envelope inset, so the host text starts on the
       art's left edge; 2px at the bottom plus the art's own 10px is the gap. */
    padding: 12px 10px 2px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0;
  }

  .name {
    font-weight: 600;
    color: var(--color-ink);
  }

  .source {
    /* ink-2. On the light palette ink-3 fell under the floor on the mat; it
       clears there now at 6.71, so this is preference rather than constraint —
       the source line reads as a label, not as metadata. */
    color: var(--color-ink-2);
  }

  .open {
    margin-left: auto;
    /* The one link convention: signal, no underline, underline on hover. These
       were ink with a permanent hairline under them and only turned blue on
       hover — an affordance drawn two ways on a site whose rule is that blue is
       the affordance. */
    color: var(--color-signal);
    text-decoration: none;
  }

  .open:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .viewport {
    /* No scrollbars in a specimen. Each `height` passed in is the story's own
       measured content height, so there is nothing to scroll to. A story cut
       off at the bottom means that number is stale — fix the number, not this
       rule. Two of the three were, by 84px and 524px. */
    overflow: hidden;
    box-sizing: border-box;
    padding: 20px;
    /* Inset on all four sides so the mat frames the art, like every other
       embed. This rule carried a comment, so an earlier edit that matched the
       other two components by exact text silently skipped it and left this one
       running to the card edge. */
    margin: 10px;
    border-radius: var(--radius-inset);
    background: var(--color-art);
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

</style>

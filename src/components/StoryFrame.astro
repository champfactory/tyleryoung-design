---
/**
 * Embeds a single component from the live Storybook, without Storybook's chrome.
 *
 * The point is that this is not a screenshot — it is the actual component from the
 * actual deployed build, rendering now. If the library breaks, this breaks, which
 * is the correct behaviour for evidence.
 *
 * Lazy-loaded so the page's own first paint is unaffected, and the caption always
 * carries a direct link in case a browser blocks third-party frames.
 */
const SB = 'https://atheer-next-storybook.fly.dev';

interface Props {
  /** Storybook story id, e.g. components-sidebar--default */
  id: string;
  label: string;
  /** Where the component came from in the design file */
  source?: string;
  note?: string;
  height?: number;
}

const { id, label, source, note, height = 520 } = Astro.props;
const src = `${SB}/iframe.html?id=${id}&viewMode=story`;
const deepLink = `${SB}/?path=/story/${id}`;
---

<figure class="story-frame">
  <div class="chrome">
    <span class="name">{label}</span>
    {source && <span class="source">{source}</span>}
    <a class="open" href={deepLink} target="_blank" rel="noopener">
      Open in library <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="viewport" style={`height:${height}px`}>
    <iframe
      src={src}
      title={`${label} — live from the component library`}
      loading="lazy"
      referrerpolicy="no-referrer"
      scrolling="no"
    ></iframe>
  </div>

  {note && <figcaption>{note}</figcaption>}
</figure>

<style>
  .story-frame {
    /* Same token as every other embed. These two carried `margin: 0 0 34px` —
       no space above at all — so a running screen started immediately under the
       paragraph introducing it while the reconstructions had room on both
       sides. */
    margin: var(--space-embed) 0 calc(var(--space-embed) + 12px);
    background: var(--color-paper-raised);
  
    /* A card, not an outlined panel: small radius, no border, the radius alone. */
    border: 0;
    border-radius: 10px;
    overflow: hidden;
  }

  .chrome {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0;
  }

  .name {
    font-weight: 600;
    color: var(--color-ink);
  }

  .source {
    color: var(--color-ink-3);
  }

  .open {
    margin-left: auto;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule-strong);
    padding-bottom: 2px;
  }

  .open:hover {
    color: var(--color-signal);
    border-bottom-color: var(--color-signal);
  }

  .viewport {
    /* No scrollbars in a specimen. Every embedded story is narrower than this
       column (the widest is 352px) and each `height` below is the story's
       measured content height, so there is nothing to scroll to. A scrollbar
       here would mean the height is wrong — fix the height, not this rule. */
    overflow: hidden;
    background: #ffffff;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--color-ink-3);
    padding: 22px 18px;
    background: #ffffff;
  }
</style>

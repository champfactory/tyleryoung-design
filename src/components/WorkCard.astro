---
/**
 * The card anatomy is inherited from the live site because it works:
 * media → eyebrow → short title → two-beat description → concrete artifact link.
 * (docs/04-style-reference.md §Card pattern.)
 *
 * What changed is the register: no color tiles, no pill buttons. Hairline rules,
 * a mono eyebrow, and artifact links that name the actual thing behind them.
 */
export interface Artifact {
  label: string;
  href?: string;
  needs?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  artifacts?: Artifact[];
  lead?: boolean;
}

const { eyebrow, title, description, artifacts = [], lead = false } = Astro.props;
---

<article class:list={['card', { lead }]}>
  <div class="media">
    <slot name="media" />
  </div>

  <div class="body">
    <p class="eyebrow">{eyebrow}</p>
    <h3 class="heading title">{title}</h3>
    {description && <p class="desc">{description}</p>}
    <slot />

    {
      artifacts.length > 0 && (
        <ul class="artifacts">
          {artifacts.map((a) => (
            <li>
              {a.href ? (
                <a class="artifact" href={a.href}
                   target={a.href.startsWith('http') ? '_blank' : undefined}
                   rel={a.href.startsWith('http') ? 'noopener' : undefined}>
                  {a.label}
                  <span aria-hidden="true">→</span>
                </a>
              ) : (
                <span class="artifact-pending">
                  {a.label} — <em>{a.needs ?? 'link pending'}</em>
                </span>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 20px;
  }

  .media:empty {
    display: none;
  }

  /* On lead cards the media is a large dark panel. Reading a black box before
     any label is disorienting — let the eyebrow and title introduce it first. */
  .lead .media {
    order: 2;
    margin-top: 8px;
  }

  .media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-rule);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-signal);
    margin: 0 0 10px;
  }

  .title {
    font-size: 26px;
    margin: 0 0 10px;
  }

  .desc {
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-ink);
    margin: 0;
    max-width: 54ch;
    text-wrap: pretty;
  }

  .artifacts {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 26px;
  }

  .artifact-pending {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    border-bottom: 1px dashed var(--color-rule-strong);
    padding-bottom: 3px;
  }

  .artifact-pending em {
    color: var(--color-signal);
    font-style: normal;
  }

  .lead .title {
    font-size: 32px;
  }

  @media (min-width: 810px) {
    .lead .title {
      font-size: 42px;
    }

    .lead .desc {
      font-size: 21px;
    }
  }
</style>

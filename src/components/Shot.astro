---
/**
 * A screen, presented as a specimen rather than decoration.
 *
 * Every instance carries real alt text describing that image — the previous site
 * shipped nine images with none at all and three sharing one wrong description.
 */
interface Props {
  src: string;
  alt: string;
  /** the name this state has in the system */
  state?: string;
  caption?: string;
  /** full-bleed out of the prose column */
  wide?: boolean;
}

const { src, alt, state, caption, wide = false } = Astro.props;
---

<figure class:list={['shot', { wide }]}>
  {
    state && (
      <p class="state">
        <span class="dot" aria-hidden="true" />
        {state}
      </p>
    )
  }
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 0 0 34px;
    border: 1px solid var(--color-rule);
    background: var(--color-paper-raised);
  }

  .state {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0;
    padding: 11px 14px;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-2);
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-signal);
    flex: none;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.7;
    letter-spacing: 0.03em;
    color: var(--color-ink-3);
    padding: 13px 14px;
    border-top: 1px solid var(--color-rule);
  }

  /* Break out of the prose measure — these are wide, dense screens. */
  @media (min-width: 1200px) {
    .wide {
      width: calc(100% + 180px);
      max-width: none;
    }
  }
</style>

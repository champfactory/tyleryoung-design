---
import Draft from './Draft.astro';
import { emphasise, type Story } from '../data/stories';
import Chevron from './Chevron.astro';

interface Props {
  story: Story;
}
const { story } = Astro.props;
const { eyebrow, claim, outcome, artifacts, emphasis, draft } = story;

/**
 * No headline. The claim and what followed it are one passage now, and the
 * emphasis carries the structure the title used to.
 */
const passage = emphasise(`${claim} ${outcome}`, emphasis);
---

<article class="story">
  <header class="head">
    <h3 class="eyebrow">{eyebrow}</h3>
  </header>

  <div class="body">
    <p class="passage">
      {
        passage.map((run) =>
          run.on ? <strong>{run.text}</strong> : run.text
        )
      }
    </p>

    <ul class="artifacts">
      {
        artifacts.map((a) => (
          <li>
            {a.href ? (
              <a
                class="artifact"
                href={a.href}
                target={a.href.startsWith('http') ? '_blank' : undefined}
                rel={a.href.startsWith('http') ? 'noopener' : undefined}
              >
                {a.label}<Chevron /></a>
            ) : (
              <span class="pending">
                {a.label} — <em>{a.needs}</em>
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="media">
    <slot name="media" />
  </div>
</article>

<style>
  .story {
    display: grid;
    gap: 24px;
    padding-top: 22px;
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  /* The card's heading. It was a span beside an h3 claim; with the claim gone
     the outline had a card with no heading in it at all, so the eyebrow takes
     the role. Same text, same look — it just exists in the outline now. */
  .eyebrow {
    margin: 0;
    font-family: var(--font-prose);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-ink-2);
  }

  /* NEW STYLE — the titleless story passage.
     No headline above it, so the passage has to do both jobs: be scannable and
     be readable. It is set large and at 500 in the quiet grey, with the phrases
     that carry the claim in full ink at 700. A reader taking only the dark
     words gets the claim; a reader taking all of it gets the story. The
     contrast between the two weights is what the headline used to be, which is
     why the base cannot simply be light grey — --color-ink-quiet is the
     lightest step that still holds AA on its own. */
  .passage {
    font-size: clamp(24px, 2.5vw, 30px);
    font-weight: 500;
    line-height: 1.42;
    letter-spacing: -0.012em;
    color: var(--color-ink-quiet);
    margin: 0;
    max-width: 30ch;
    text-wrap: pretty;
  }

  .passage strong {
    font-weight: 700;
    color: var(--color-ink);
  }

  .artifacts {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 26px;
  }

  .pending {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-ink-3);
    border-bottom: 1px dashed var(--color-rule-strong);
    padding-bottom: 3px;
  }

  .pending em {
    color: var(--color-signal);
    font-style: normal;
  }

  .media:empty {
    display: none;
  }

  /* The frame carries margins so prose does not butt into it on a case-study
     page. Inside a card the grid owns the spacing, so take both back — the top
     one especially: with it, the embed started a whole `--space-embed` below the
     eyebrow it is supposed to line up with. */
  .media :global(.live) {
    margin: 0;
  }

  .media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 1000px) {
    .story {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'head  media'
        'body  media';
      grid-template-rows: auto 1fr;
      column-gap: 56px;
      row-gap: 20px;
    }

    .head {
      grid-area: head;
    }
    .body {
      grid-area: body;
    }
    .media {
      grid-area: media;
    }
  }
</style>

---
import Draft from './Draft.astro';
import type { Story } from '../data/stories';
import Chevron from './Chevron.astro';

interface Props {
  story: Story;
}
const { story } = Astro.props;
const { slug, eyebrow, claim, outcome, artifacts, draft } = story;
---

<article class="story">
  <header class="head">
    <span class="eyebrow">{eyebrow}</span>
  </header>

  <div class="body">
    <h3 class="heading claim">
      <a class="claim-link" href={slug}>{draft ? <Draft>{claim}</Draft> : claim}</a>
    </h3>
    <p class="outcome">
      {draft ? <Draft>{outcome}</Draft> : outcome}
    </p>

    <ul class="artifacts">
      {
        artifacts.map((a) => (
          <li>
            {a.href ? (
              <a
                class="artifact"
                href={a.href}
                target={a.href.startsWith('http') ? '_blank' : undefined}
                rel={a.href.startsWith('http') ? 'noopener' : undefined}
              >
                {a.label}<Chevron /></a>
            ) : (
              <span class="pending">
                {a.label} — <em>{a.needs}</em>
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="media">
    <slot name="media" />
  </div>
</article>

<style>
  /* The claim links to its story, and does not say so. No underline, no colour,
     no hover change: the card already carries explicit artifact links below,
     and this is a convenience for people who aim at the headline rather than a
     second affordance competing with them.

     Keyboard focus is the exception and stays visible. An affordance may be
     invisible; it may not also be unreachable. The global :focus-visible ring
     handles it, so there is nothing to declare here. */
  .claim-link {
    color: inherit;
    text-decoration: none;
  }

  .story {
    display: grid;
    gap: 24px;
    padding-top: 22px;
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .eyebrow {
    font-family: var(--font-prose);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-ink-2);
  }

  /* The claim is the 15-second read. It gets headline weight. */
  .claim {
    font-size: clamp(28px, 4.4vw, 44px);
    margin: 0 0 18px;
  }

  .outcome {
    font-size: 20px;
    /* One step up from body. At 400 the card's only paragraph read lighter than
       the ink around it; 500 gives it the weight of the claim it supports. */
    font-weight: 500;
    line-height: 1.55;
    color: var(--color-ink);
    margin: 0;
    max-width: 52ch;
    /* `balance` rather than `pretty`. Pretty only protects the last line from a
       one-word widow; balance evens every line, which is what fixes a ragged
       right edge as well. A summary here is four or five lines, inside the
       six-line ceiling browsers put on balancing. */
    text-wrap: balance;
  }

  /* On a phone the fix is the type size, not the wrapping mode.

     At 20px a summary runs to eight or ten lines in a 335px column, which is
     past the six-line ceiling where browsers stop balancing — so the rag
     collapses and a single word ends up alone on the last line. Dropping to
     17px brings the same text back under the ceiling and balance re-engages.

     Measured against the alternative of swapping balance for `pretty`, which
     is the obvious move and the wrong one: at 430px pretty gives last lines of
     61%, 28% and 24% across the three cards, where 17px balanced gives 95%,
     100% and 93%. 17px is also what iOS sets body text at, so this is not a
     compromise size. */
  @media (max-width: 480px) {
    .outcome {
      font-size: 17px;
    }
  }

  .artifacts {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 26px;
  }

  .pending {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-ink-3);
    border-bottom: 1px dashed var(--color-rule-strong);
    padding-bottom: 3px;
  }

  .pending em {
    color: var(--color-signal);
    font-style: normal;
  }

  .media:empty {
    display: none;
  }

  /* The frame carries margins so prose does not butt into it on a case-study
     page. Inside a card the grid owns the spacing, so take both back — the top
     one especially: with it, the embed started a whole `--space-embed` below the
     eyebrow it is supposed to line up with. */
  .media :global(.live) {
    margin: 0;
  }

  .media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 1000px) {
    .story {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'head  media'
        'body  media';
      grid-template-rows: auto 1fr;
      column-gap: 56px;
      row-gap: 20px;
    }

    .head {
      grid-area: head;
    }
    .body {
      grid-area: body;
    }
    .media {
      grid-area: media;
    }
  }
</style>

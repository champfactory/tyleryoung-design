---
import { REPO, EMAIL } from '../data/site.mjs';
import { storyLinks } from '../data/stories';
import Chevron from './Chevron.astro';

/**
 * The left column is the three case studies, on every page. Related work used to
 * sit in a block above the footer with a sentence explaining each destination; a
 * reader who has just finished a case study does not need the explanation, and
 * two stacks of links one above the other read as two footers.
 *
 * It is not a per-page list any more. When each page chose its own, the two
 * columns came out different lengths and the rows stopped lining up across the
 * page.
 */
interface Props {
  related?: [string, string][];
}
const { related = storyLinks } = Astro.props;

/** The links this site carries on every page. */
const site: [string, string, boolean][] = [
  ['/colophon', 'How this site is built', false],
  [REPO, 'Source', true],
  [`mailto:${EMAIL}`, EMAIL, false],
];

/**
 * Paired into rows so the two columns line up across the page rather than being
 * two independent stacks that happen to share a footer.
 */
const rows = Array.from({ length: Math.max(related.length, site.length) }, (_, i) => ({
  left: related[i],
  right: site[i],
}));
---

<footer class="footer on-dark">
  <div class="shell inner">
    {
      rows.map((row) => (
        <div class="foot-row">
          <span class="foot-left">
            {row.left && (
              <a class="artifact" href={row.left[0]}>
                {row.left[1]}<Chevron /></a>
            )}
          </span>
          <span class="foot-right">
            {row.right && (
              <a
                class="artifact"
                href={row.right[0]}
                target={row.right[2] ? '_blank' : undefined}
                rel={row.right[2] ? 'noopener' : undefined}
              >
                {row.right[1]}<Chevron /></a>
            )}
          </span>
        </div>
      ))
    }
  </div>
</footer>

<style>
  /* Element selectors, not `.inner`. A scoped class rule on this wrapper did not
     apply — the same thing happened to the header's `.statement` — and the links
     fell back to inline flow, running together on one line at the left edge. */
  /* The footer is the page's baseplate now, not more page. It bleeds the full
     width — the `.shell` inside keeps the links on the same measure as the
     content above — and the dark field is what ends the document. The blue
     links inside turn white through the `.on-dark` alternate in global.css;
     nothing here restates that. */
  /* No top margin. The 96px was there when the footer was more page and needed
     separating from the content above it; a dark full-bleed band separates
     itself, and the gap only read as a strip of loose grey between the last
     section and the baseplate. The footer's own padding does the spacing now,
     from inside the dark. */
  footer {
    padding-block: 44px 48px;
    background: var(--color-deep);
  }


  footer > div {
    display: grid;
    gap: 8px;
  }

  /* Two columns, one row each. The page's own links sit flush left and the
     site-wide ones flush right, so a row reads as a pair rather than as two
     stacks that happen to share a footer. */
  footer .foot-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }

  footer .foot-left {
    text-align: left;
  }

  footer .foot-right {
    text-align: right;
  }

  @media (min-width: 700px) {
    footer .foot-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: baseline;
      gap: 40px;
    }
  }
</style>

---
import { REPO, EMAIL, YEAR as year } from '../data/site.mjs';
---

<footer class="footer">
  <div class="shell inner">
    {/* Three destinations and a copyright, right-aligned. The colophon link is
        what carries the built-with-my-own-workflow claim now — the sentence that
        used to sit here made the same point in prose, and the stack line beside
        it named tools nobody was going to act on. */}
    <a class="artifact" href="/colophon">
      How this site is built
      <span aria-hidden="true">→</span>
    </a>
    <a class="artifact" href={REPO} target="_blank" rel="noopener">
      Source
      <span aria-hidden="true">→</span>
    </a>
    <a class="artifact" href={`mailto:${EMAIL}`}>
      {EMAIL}
      <span aria-hidden="true">→</span>
    </a>
    <p class="year">© {year} Tyler Young</p>
  </div>
</footer>

<style>
  /* Element selectors, not `.inner`. A scoped class rule on this wrapper did not
     apply — the same thing happened to the header's `.statement` — and the links
     fell back to inline flow, running together on one line at the left edge. */
  footer {
    margin-top: 96px;
    padding-block: 32px 56px;
  }

  footer > div {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 18px;
  }

  footer p {
    margin: 6px 0 0;
    font-size: 19px;
    color: var(--color-ink);
  }
</style>

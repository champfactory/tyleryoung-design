---
import Needs from './Needs.astro';
import { REPO, EMAIL, YEAR as year } from '../data/site.mjs';
---

<footer class="footer">
  <div class="shell inner">
    <div class="colophon">
      <p class="label">Colophon</p>
      <p class="built">
        {/* The one sentence that makes this site part of the evidence.
            Tyler writes or approves it — do not ship invented copy here. */}
        <Needs>the built-with-my-own-workflow sentence — Tyler approves the wording</Needs>
      </p>
      <p class="stack">
        Astro · React · Tailwind · static output · no client JavaScript on content pages
      </p>
      <p class="links">
        <a class="artifact" href="/colophon">
          How this site is built
          <span aria-hidden="true">→</span>
        </a>
        <a class="artifact" href={REPO} target="_blank" rel="noopener">
          Source
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>

    <div class="ends">
      <a class="artifact" href={`mailto:${EMAIL}`}>
        {EMAIL}
        <span aria-hidden="true">→</span>
      </a>
      <p class="label year">© {year} Tyler Young</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 96px;
    border-top: 1px solid var(--color-ink);
    padding-block: 32px 56px;
  }

  .inner {
    display: grid;
    gap: 32px;
  }

  .colophon {
    max-width: 60ch;
  }

  .built {
    margin: 12px 0 10px;
    font-size: 19px;
    line-height: 1.55;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 26px;
    margin: 20px 0 0;
  }

  .stack {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-ink-3);
    line-height: 1.6;
  }

  .ends {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .year {
    margin: 0;
  }

  @media (min-width: 810px) {
    .inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 48px;
    }

    .ends {
      align-items: flex-end;
      text-align: right;
    }
  }
</style>

---
/**
 * A note, and what it did.
 *
 * The feedback line sits above the pair so the causal chain is unmissable:
 * someone asked for this, and here is the before and after. Stacked rather than
 * side by side because these are wide, short strips of interface — side by side
 * would halve them to illegibility.
 *
 * It used to carry two more parts: a `label` naming the kind of decision, and a
 * `tell` caption explaining the change. Both repeated what the heading and the
 * prose immediately above had already said, so the same point arrived three
 * times in three different type styles. The verbatim note is the only thing
 * here that exists nowhere else on the page, so it is the only thing kept.
 */
interface Props {
  /** the reviewer's note, verbatim from FEEDBACK.md */
  note: string;
  before: string;
  after: string;
  beforeAlt: string;
  afterAlt: string;
  /** what each state shows, for a reader who cannot see the difference at a glance */
  beforeNote?: string;
  afterNote?: string;
}

const { note, before, after, beforeAlt, afterAlt, beforeNote, afterNote } = Astro.props;
---

<figure class="compare">
  <p class="note">{note}</p>

  <div class="pair">
    <div class="side">
      <p class="tag">Before</p>
      <img src={before} alt={beforeAlt} loading="lazy" decoding="async" />
      {beforeNote && <p class="side-note evidence-foot">{beforeNote}</p>}
    </div>
    <div class="side">
      <p class="tag after">After</p>
      <img src={after} alt={afterAlt} loading="lazy" decoding="async" />
      {afterNote && <p class="side-note evidence-foot">{afterNote}</p>}
    </div>
  </div>

</figure>

<style>
  /* One warm surface, no outlines and no rules.
     The screenshots are mostly white and dark interface, so mounting them on
     the page's band separates them from the document without drawing a box — a border around a border around a screenshot was three edges to say
     one thing. Space does the dividing that a horizontal rule used to. */
  .compare {
    display: grid;
    gap: 24px;
    margin: var(--space-embed) 0;
    /* 10px, the one inset every envelope on the site uses. This card was at
       26/30 and the capture cards at 18 — three numbers for one convention. */
    padding: 10px 10px 12px;
    border-radius: var(--radius-mat);
    background: var(--color-mount);
  }

  /* The reviewer's own words, and the only text in here. */
  .note {
    margin: 2px 0 0 !important;
    font-size: 17px !important;
    line-height: 1.5 !important;
    letter-spacing: 0;
    color: var(--color-ink) !important;
  }

  .pair {
    display: grid;
    gap: 24px;
  }

  .side {
    padding: 0;
  }

  /* Before and after separate by weight, not by hue. The after tag used to be
     signal blue, which is the link colour and nothing else on this site. */
  .tag {
    margin: 0 0 9px !important;
    font-size: 13px !important;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-ink-2) !important;
  }

  .tag.after {
    font-weight: 600;
    color: var(--color-ink) !important;
  }

  /* Type and colour come from .evidence-foot; the side already sits at the
     mat inset, so this adds only the gap under the art. */
  .side-note {
    --foot-pad: 10px 0 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border: 0;
    border-radius: var(--radius-inset);
  }
</style>

---
/**
 * A page headline, sized to fill its measure.
 *
 * Every H1 on the site goes through here. The class was always shared; the
 * size is what was not, and a shared size is what made one title span the
 * column while another stopped two-thirds of the way across. `fitDisplay`
 * measures the actual text and returns the size at which it fills the line.
 */
import { fitDisplay } from '../data/display-fit.mjs';

interface Props {
  /** The headline text, used to compute the size. Markup goes in the slot. */
  text: string;
}

const { text } = Astro.props;
const fit = fitDisplay(text);
---

<div class="display-fit">
  <h1 class="display" style={`font-size:${fit.fontSize}`}><slot /></h1>
</div>

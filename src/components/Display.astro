---
/**
 * A page headline. Every H1 outside the landing page goes through here, and
 * they are all one size.
 *
 * This used to compute a size per title so each one would span its measure.
 * It worked, and it was the wrong goal: the size then depended on where the
 * words happened to break, so three lines came out bigger than two and the
 * site ran 46px to 105px across thirteen pages. A title that ends short of the
 * right edge is normal. Thirteen sizes of the same component is not.
 *
 * The size is --text-display. There is nothing to pass and nothing to tune.
 */
interface Props {
  /** The headline text. Kept for the default slot; it no longer sizes anything. */
  text: string;
}
---

<h1 class="display"><slot /></h1>

---
import Chevron from './Chevron.astro';

/**
 * NEW PATTERN — a gated sequence.
 *
 * Nothing in the system carried this shape. `.loop` is a sequence but has no
 * exits; a plain ordered list has neither. What makes this a framework rather
 * than a checklist is that a note can leave at any gate, and where it left
 * decides what happened to it — so the exits have to be visible, and they have
 * to point at the evidence.
 *
 * The rule down the left is the sequence. The nodes are the gates. A note that
 * stops at a gate hangs off it, and the hanging line links to the worked
 * example that stopped there, so the framework and its proof are one object
 * instead of a list followed by an argument that they match.
 *
 * The terminal node is open rather than filled: it is not a gate, it is what
 * happens when nothing stops.
 *
 * Everything here is system tokens — ink, ink-2, rule, signal, the existing
 * type steps. The only invention is the geometry.
 */
interface Props {
  gates: {
    question: string;
    answer: string;
    /** the note that left the sequence here, if one did */
    exit?: { verb: string; what: string; href: string };
  }[];
  /** what happens to a note that clears every gate */
  through: { verb: string; what: string; href: string };
}

const { gates, through } = Astro.props;
---

<ol class="gates">
  {
    gates.map((g) => (
      <li class="gate">
        <p class="q">{g.question}</p>
        <p class="a">{g.answer}</p>
        {g.exit && (
          <p class="exit">
            <span class="verb">{g.exit.verb}</span>
            <a class="link" href={g.exit.href}>
              {g.exit.what}<Chevron weight="light" /></a>
          </p>
        )}
      </li>
    ))
  }
  <li class="gate through">
    <p class="exit">
      <span class="verb">{through.verb}</span>
      <a class="link" href={through.href}>
        {through.what}<Chevron weight="light" /></a>
    </p>
  </li>
</ol>

<style>
  .gates {
    list-style: none;
    margin: var(--space-block) 0;
    padding: 0;
    counter-reset: gate;
  }

  /* 26px, the same indent every plain list uses, so a gate's question starts
     on the same left edge as a list item further down the page. It was 34px
     and 40px, which put this block on an edge of its own.

     The rule is drawn per item rather than once down the container, so the
     last node ends the line instead of the line overshooting past it. */
  .gate {
    position: relative;
    padding: 0 0 26px 26px;
    counter-increment: gate;
  }

  .gate:not(:last-child)::after {
    content: '';
    position: absolute;
    /* Centred under a 0.78em marker, and starting below it: the marker sits
       from 0.44em to 1.22em, and a line that starts any higher shows through
       the knockout in the middle of the glyph. */
    left: 0.385em;
    top: 1.34em;
    bottom: -0.3em;
    width: 1px;
    background: var(--color-rule);
  }

  /* The Alucify bullet, same glyph and same geometry the lists use, so the
     nodes line up with the markers above and below them. */
  .gate::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.44em;
    width: 0.78em;
    height: 0.78em;
    background: currentColor;
    -webkit-mask: var(--mark-bullet) center / contain no-repeat;
    mask: var(--mark-bullet) center / contain no-repeat;
    color: var(--color-ink);
  }

  /* Not a gate — the way out when nothing stops. The hollow glyph, so the
     difference is a different mark rather than a different treatment. */
  .through::before {
    -webkit-mask-image: var(--mark-hollow);
    mask-image: var(--mark-hollow);
    color: var(--color-ink-3);
  }

  .through {
    padding-bottom: 0;
  }

  .q {
    margin: 0;
    font-size: var(--text-body);
    line-height: 1.45;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .a {
    margin: 6px 0 0;
    font-size: var(--text-note);
    line-height: 1.55;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  /* The exit hangs off the gate it leaves from. */
  .exit {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 12px 0 0;
    font-size: var(--text-note);
    line-height: 1.5;
  }

  .verb {
    color: var(--color-ink-3);
  }
</style>

---
/**
 * The long-form document: essays and case studies share one anatomy.
 *
 * eyebrow · H1 · metadata rail · prose · (optional) cross-links
 *
 * The live site's essay anatomy is preserved (docs/02-content-inventory.md says
 * "preserve exactly — it works"); only the visual register changed. Case studies
 * use the same shell so a technical piece reads as a sibling of the leadership
 * essays rather than a bolt-on.
 */
import PageHead from '../components/PageHead.astro';
import BaseLayout from './BaseLayout.astro';
import Needs from '../components/Needs.astro';
import Draft from '../components/Draft.astro';

export type MetaPair = [label: string, value: string];

interface Props {
  title: string;
  /** the original full sentence, kept under the short title */
  deck?: string;
  /** true when the short title is mine, not Tyler's */
  titleDraft?: boolean;
  /** one verbatim line from the body, surfaced above the prose */
  pull?: string;
  metaTitle: string;
  description?: string;
  descriptionDraft?: boolean;
  eyebrow: string;
  meta: MetaPair[];
  current?: string;
  related?: [string, string][];
}

const {
  title,
  deck,
  titleDraft,
  pull,
  metaTitle,
  description,
  descriptionDraft,
  eyebrow,
  meta,
  current,
  related,
} = Astro.props;
---

<BaseLayout
  title={metaTitle}
  description={description}
  descriptionDraft={descriptionDraft}
  current={current}
  related={related}
>
  <article class="shell doc">
    <PageHead eyebrow={eyebrow} title={title} deck={deck}>
      {titleDraft ? <Draft>{title}</Draft> : title}
    </PageHead>

    <div class="columns">
      <aside class="rail" aria-label="Metadata">
        <dl>
          {
            meta.map(([label, value]) => (
              <div class="row">
                <dt>{label}</dt>
                <dd set:html={value} />
              </div>
            ))
          }
        </dl>
      </aside>

      <div class="prose">
        {pull && <p class="pull">{pull}</p>}
        <slot />
      </div>
    </div>
  </article>

  <slot name="after" />
</BaseLayout>

<style is:global>
  /* Global rather than scoped: the prose styles have to reach markdown rendered
     by <Content />, and both essays and hand-authored case studies use them. */
  /* Every page's first line lands at the same height. This was 64px here and
     88px on /essays, and the eyebrow's default paragraph margin pushed the
     document pages down further still — so titles jumped vertically whenever you
     moved between the two. One token, and the eyebrow's margin zeroed. */
  .doc {
    padding-top: var(--space-page-top);
  }

  /* Colour and weight come from `.label` in global.css; only the spacing is
     this layout's business. */

  /* Diagrams recovered from the live site. These are the instruments the essays
     describe — scoring rubrics, before/after tables, the two-by-twos — so they
     run the full measure of the prose column rather than sitting inline. Every
     one shipped with empty alt text originally; each now describes itself. */
  /* Global, alongside .essay-fig. Scoped to the page these did not apply at all —
     the rules were emitted but never matched — so the iframe fell back to its
     replaced-element default of 300x150 and the caption rendered as body copy. */
  /* ---- colophon ---------------------------------------------------------
     Global, like .essay-fig and .figma: scoped to the page these rules are
     emitted but never match, so the layout silently falls back to prose. */

  /* Four equal cells, tinted alternately across the row. Same banding as the
     lists below, turned on its side. No rule and no gap — the tint does the
  /* The prose list marker out-specifies a plain override, and these lists are
     not prose. Everywhere a custom list appears on this page, the marker is off. */
  .doc .principles > li::before,
  .doc .ledger > li::before,
  .doc .ledger-compare li::before {
    content: none !important;
  }

  .doc .principles,
  .doc .ledger {
    list-style: none;
    margin: 24px 0 30px;
    padding: 0;
  }

  /* Banded rather than ruled. The tint bleeds past the text on both sides so the
     copy stays aligned with the prose above it instead of being inset by the
     padding. */
  .doc .principles > li,
  .doc .ledger > li {
    margin: 0;
    padding: 15px 16px;
    margin-inline: -16px;
    border: 0;
  }

  .doc .principles > li:nth-child(odd),
  .doc .ledger > li:nth-child(odd) {
    background: var(--color-row);
  }

  .doc .principle {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.35;
  }

  .doc .principle-detail,
  .doc .gate-req {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-ink);
  }

  .doc .gate-req {
    color: var(--color-ink);
  }

  .doc .gate-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 8px 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0;
  }

  /* No marker beside these. The words already say which is which, so a square or
     a circle repeated the label in a second language. */
  .doc .gate-mode {
    color: var(--color-ink-3);
  }

  .doc .gate-how {
    color: var(--color-ink-3);
    text-transform: none;
    letter-spacing: 0;
  }

  /* Paired rows, banded like the lists above. Tighter than those, because each
     cell is one line rather than a heading and a paragraph. */
  .doc .ledger-compare {
    margin: 26px 0 30px;
  }

  .doc .ledger-row {
    display: grid;
    gap: 2px 40px;
    padding: 9px 16px;
    margin-inline: -16px;
  }

  .doc .ledger-row:nth-of-type(even) {
    background: var(--color-row);
  }

  .doc .ledger-row p {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
  }

  .doc .ledger-row .was {
    color: var(--color-ink);
  }

  .doc .ledger-heads {
    display: none;
    padding-bottom: 4px;
    background: none !important;
  }

  .doc .ledger-heads p {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-ink-3);
  }

  /* Stacked, each line needs its own label; side by side, the column heads carry
     it and repeating the word on every row is noise. */
  .doc .ledger-compare .tag {
    display: inline-block;
    min-width: 62px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0;
    color: var(--color-ink-3);
  }

  .doc .pull-line {
    text-wrap: pretty;
    /* The rule sits on the prose's own left edge, in line with the paragraphs
       above and below it. The gap to the quote is 26px rather than 16 — the
       rule needs room around it, not a tighter grip on the text. */
    margin: 26px 0 34px;
    padding-left: 26px;
    border-left: 4px solid var(--color-ink);
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.012em;
  }

  .doc .result-line {
    text-wrap: pretty;
    margin: 22px 0 14px;
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 620;
    letter-spacing: -0.012em;
  }

  /* The ratio tables. These had no styles at all, so the swatch collided with the
     label and the column headers ran together. Banded to match the rows above,
     numbers right-aligned and monospaced so they compare down the column. */
  .doc .ratios {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 10px;
    font-size: 15px;
  }

  .doc .ratios th {
    padding: 0 14px 9px 16px;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-ink-3);
    border-bottom: 1px solid var(--color-rule);
  }

  .doc .ratios td {
    padding: 10px 14px 10px 16px;
    vertical-align: middle;
  }

  .doc .ratios tbody tr:nth-child(odd) {
    background: var(--color-row);
  }

  .doc .ratios .num {
    width: 1%;
    text-align: right;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .doc .ratios .dim {
    color: var(--color-ink-3);
  }

  .doc .ratios .use {
    font-size: 13px;
    color: var(--color-ink);
  }

  /* The swatch is the evidence: the pair rendered at the ratio being claimed. */
  .doc .swatch {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 22px;
    margin-right: 12px;
    vertical-align: -6px;
    font-size: 12px;
    line-height: 1;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--color-rule);
  }

  .doc .all-pairs {
    margin: 0 0 34px;
    border-top: 1px solid var(--color-rule);
  }

  .doc .all-pairs summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0;
    color: var(--color-ink);
    cursor: pointer;
  }

  .doc .all-pairs summary:hover {
    color: var(--color-signal);
  }

  /* The table scrolls inside its own box rather than pushing the document
     sideways on a narrow screen. */
  .doc .scroller {
    overflow-x: auto;
    padding-bottom: 4px;
  }







  @media (min-width: 700px) {
    .doc .ledger-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .doc .ledger-compare .tag {
      display: none;
    }

    .doc .ledger-heads {
      display: grid;
    }

  }






  .doc .essay-fig {
    margin: 34px 0;
  }

  .doc .essay-fig img {
    display: block;
    width: 100%;
    height: auto;
  }



  .doc .meta-warning {
    margin: 20px 0 0;
  }

  .doc .columns {
    margin-top: 56px;
    display: grid;
    gap: 40px;
    padding-top: 32px;
  }

  .doc .rail .meta-flag {
    margin: 0 0 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-rule);
    line-height: 1.9;
  }

  .doc .rail dl {
    margin: 0;
    display: grid;
    gap: 22px;
  }

  .doc .rail .row {
    display: grid;
    gap: 6px;
  }

  .doc .rail dt {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0;
    color: var(--color-ink-2);
  }

  .doc .rail dd {
    text-wrap: pretty;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.65;
    color: var(--color-ink);
  }

  /* The rail carries live URLs. Without an affordance they read as plain text —
     and the copy beside them refers to "both links", which is only true if a
     reader can see that they are links. */
  .doc .rail a {
    color: var(--color-signal);
    text-decoration: none;
    transition: opacity 120ms ease;
  }

  .doc .rail a:hover,
  .doc .rail a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The banded-cell pattern below, carrying a glyph. Layout and banding come
     from `.cells`; only what is particular to a legend lives here. */
  .doc .shape-key > li {
    text-align: center;
    padding: 22px 16px;
  }

  .doc .shape-key svg {
    display: block;
    margin: 0 auto 12px;
  }

  .doc .shape-key .glyph {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 2;
  }

  .doc .shape-key span {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0;
    color: var(--color-ink-3);
  }

  /* ---- banded cells ------------------------------------------------------- */

  /* Equal-width boxes, tinted alternately, grey first. This is the one pattern
     for a short row of parallel things — a pair of links, three questions, four
     figures. `.shape-key` above is the same pattern carrying a glyph, and reuses
     these rules rather than restating them. */
  .doc .cells {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    margin: 26px 0 var(--space-block);
    padding: 0;
  }

  .doc .cells > li {
    margin: 0;
    padding: 20px 18px;
  }

  .doc .cells > li::before {
    content: none !important;
  }

  .doc .cells > li:nth-child(odd) {
    background: var(--color-row);
  }

  /* A column of single numbers wastes a phone screen; two-up is still legible. */
  .doc .cells.four {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* A cell holds a label and one of: a line of text, a host, or a figure. The
     label reads as a caption under a figure and as a heading above prose, so the
     spacing is set by what it sits next to rather than baked into the label. */
  .doc .cell-label {
    display: block;
    margin: 0 !important;
    font-family: var(--font-mono) !important;
    font-size: 13px !important;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0;
    color: var(--color-ink-3) !important;
  }

  .doc .cell-note {
    display: block;
    margin: 8px 0 0 !important;
  }

  .doc .cell-note {
    font-size: 16px !important;
    line-height: 1.45 !important;
    text-wrap: pretty;
  }

  .doc .cell-figure {
    text-wrap: pretty;
    display: block;
    margin: 0 !important;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 620;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .doc .cell-figure + .cell-label {
    margin-top: 5px !important;
  }

  /* A short qualifier under a figure or a strip of them — smaller than body,
     the same grey as a caption, so it reads as a footnote to the thing above it
     rather than as the next paragraph. */
  .doc .note-line {
    text-wrap: pretty;
    margin: -18px 0 var(--space-block) !important;
    font-family: var(--font-mono) !important;
    font-size: 13.5px !important;
    line-height: 1.7 !important;
    letter-spacing: 0;
    color: var(--color-ink-3) !important;
  }

  /* ---- static state captures ---------------------------------------------- */

  /* Component states captured from the library, shown side by side. Live embeds
     are the primary evidence; loading a separate iframe for every variant would
     cost more than it proves, so secondary states are images.

     Captured at one viewport width so they are directly comparable, then shown
     at their natural height. An earlier version forced them into a common 4:3
     box: at 654x1212 that cropped away everything below the photograph, so a
     caption reading "the card expands to support a larger procedure set" sat
     above an image with no procedures in it. Ragged bottoms are the cheaper
     problem.

     The anatomy matches a live embed exactly — a header naming the state and the
     surface, then the evidence, then one caption saying what to look at. It used
     to carry three labels in two places: a blue surface tag above the image and
     a black state name below it, which read as two competing titles for the same
     thing. */
  .doc .captures {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    margin: 30px 0 var(--space-block);
    padding: 0;
  }

  .doc .captures > li {
    margin: 0;
    padding: 0;
    align-self: start;
    border: 1px solid var(--color-rule);
    background: var(--color-paper-raised);
  }

  .doc .captures > li::before {
    content: none !important;
  }

  /* The same header a running embed wears. */
  .doc .capture-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0;
  }

  .doc .capture-name {
    text-wrap: pretty;
    color: var(--color-ink);
  }

  .doc .capture-surface {
    color: var(--color-ink-3);
  }

  .doc .capture-shot {
    display: block;
    width: 100%;
    height: auto;
  }

  .doc .capture-note {
    text-wrap: pretty;
    display: block;
    margin: 0 !important;
    padding: 13px 14px;
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-mono) !important;
    font-size: 13.5px !important;
    line-height: 1.7 !important;
    letter-spacing: 0;
    color: var(--color-ink-3) !important;
  }

  /* ---- the equipment junction --------------------------------------------- */

  /* One record and the three things it connects to. The head is the subject; the
     banded cells beneath it are what hangs off it. */
  .doc .junction-head {
    margin: 30px 0 0 !important;
    padding: 18px;
    border: 1px solid var(--color-ink);
  }

  .doc .junction-head + .cells {
    margin-top: 0;
  }

  .doc .junction-arrow {
    display: block;
    margin: 0 !important;
    padding: 8px 0;
    font-family: var(--font-mono) !important;
    font-size: 13.5px !important;
    letter-spacing: 0;
    color: var(--color-ink-3) !important;
  }

  /* ---- the review loop ---------------------------------------------------- */

  /* A sequence, not a cycle. Banded like every other list on the site — no
     rules, no arrows, no animation — with the two stages a person is
     accountable for named in words, because the argument of the page is that
     those two are not removable. */
  .doc .loop {
    list-style: none;
    margin: 30px 0 var(--space-block);
    padding: 0;
  }

  .doc .loop > li {
    margin: 0;
    padding: 16px 18px;
  }

  .doc .loop > li::before {
    content: none !important;
  }

  .doc .loop > li:nth-child(odd) {
    background: var(--color-row);
  }

  .doc .loop-actor {
    display: block;
    margin: 0 !important;
    font-family: var(--font-mono) !important;
    font-size: 13.5px !important;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-ink) !important;
  }

  .doc .loop-what {
    text-wrap: pretty;
    display: block;
    margin: 6px 0 0 !important;
    font-size: 17px !important;
    line-height: 1.45 !important;
  }

  .doc .loop-gate {
    display: block;
    margin: 6px 0 0 !important;
    font-family: var(--font-mono) !important;
    font-size: 13px !important;
    font-weight: 650;
    letter-spacing: 0;
    color: var(--color-ink-2) !important;
  }

  @media (min-width: 700px) {
    .doc .cells.two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .doc .cells.three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .doc .cells.four {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .doc .captures.two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .doc .captures.three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Three columns: who, what, and whether a person has to sign it off. The
       first is sized to the longest actor name, not to a fraction of the page —
       a wide column holding an 11px label is just a gap. */
    .doc .loop > li {
      display: grid;
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr) auto;
      gap: 24px;
      align-items: baseline;
    }

    .doc .loop-what,
    .doc .loop-gate {
      margin: 0 !important;
    }

    .doc .loop-gate {
      text-align: right;
    }
  }

  .doc .prose {
    max-width: 68ch;
    min-width: 0;
  }

  /* Breaks the prose measure. At display size a 68ch cap computed on the body's
     19px leaves a pull quote sitting in half a column with dead space beside it. */
  .doc .pull {
    max-width: none;
    margin: 0 0 34px;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.018em;
    font-size: clamp(23px, 3.1vw, 30px);
    line-height: 1.28;
    color: var(--color-ink);
    text-wrap: balance;
  }

  /* ---- case-study evidence patterns ------------------------------------- */

  /* The opening paragraph of a case study. This was declared four times across
     four page files as .opening or .answer, and none of them emitted anything —
     so every lede on the site was rendering unstyled. One class, one place. */
  .doc .lede {
    margin: 0 0 20px;
    font-size: var(--text-lede);
    line-height: 1.45;
    letter-spacing: -0.004em;
    text-wrap: pretty;
  }

  .doc .sec-eyebrow {
    margin: 76px 0 10px;
    font-family: var(--font-mono);
    font-size: 16px;
    /* 600 to match the rail's labels. At 500 the mono looked thin against the
       display type it introduces, and the two blue labels on a page were set at
       different weights. */
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-ink-2);
  }

  .doc .prose > .sec-eyebrow + h2:not([class]) {
    margin-top: 0;
  }

  /* ---- running screens ---------------------------------------------------- */

  /* Embeds are the evidence, so they get room on both sides rather than sitting
     hard against the paragraph that introduces them. */
  .doc .recon {
    margin: var(--space-embed) 0 calc(var(--space-embed) + 12px);
  
    /* Card, not outline: radius, no rule, no shadow. */
    border: 0;
    border-radius: 10px;
    overflow: hidden;
  }

  .doc .recon-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0;
  }

  /* Was green, to pair with a green dot. The dot is gone and the accent is
     blue, so this is the same ink as the label beside it. */
  .doc .recon-live {
    display: inline-flex;
    align-items: center;
    color: var(--color-ink);
  }


  .doc .recon-label {
    color: var(--color-ink);
  }

  .doc .recon-host {
    color: var(--color-ink-3);
    text-transform: none;
    letter-spacing: 0;
  }

  .doc .recon-open {
    color: var(--color-signal);
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-ink);
  }

  .doc .recon-open:hover {
    color: var(--color-signal);
    border-bottom-color: var(--color-signal);
  }

  .doc .recon-viewport {
    position: relative;
    overflow: hidden;
    background: var(--color-paper-sunk);
  }

  /* Sits under the iframe: visible while it loads, and all that is left if it
     never arrives. Never an unexplained rectangle. */
  .doc .recon-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    margin: 0;
    padding: 24px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0;
    color: var(--color-ink-3);
  }

  .doc .recon iframe {
    position: relative;
    border: 0;
    transform-origin: top left;
    /* Decorative preview — the header link is the real affordance. */
    pointer-events: none;
    background: #ffffff;
  }

  .doc .recon figcaption {

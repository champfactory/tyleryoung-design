---
/**
 * The long-form document: essays and case studies share one anatomy.
 *
 * eyebrow · H1 · metadata rail · prose · (optional) cross-links
 *
 * The live site's essay anatomy is preserved (docs/02-content-inventory.md says
 * "preserve exactly — it works"); only the visual register changed. Case studies
 * use the same shell so a technical piece reads as a sibling of the leadership
 * essays rather than a bolt-on.
 */
import PageHead from '../components/PageHead.astro';
import Chevron from '../components/Chevron.astro';
import BaseLayout from './BaseLayout.astro';
import Needs from '../components/Needs.astro';
import Draft from '../components/Draft.astro';

export type MetaPair = [label: string, value: string];
/** `current` renders the page you are already on: listed, not linked. */
/**
 * `current` renders the page you are already on: listed, not linked.
 * `external` opens in a new tab. The design system is on this domain but is its
 * own property, so it behaves like the Storybook and the repo, not like a page.
 */
export type RailLink = {
  label: string;
  href: string;
  current?: boolean;
  external?: boolean;
  /** id of a <Sheet> this opens instead of navigating */
  sheet?: string;
};

interface Props {
  title: string;
  /** the original full sentence, kept under the short title */
  deck?: string;
  /** true when the short title is mine, not Tyler's */
  titleDraft?: boolean;
  /** one verbatim line from the body, surfaced above the prose */
  pull?: string;
  metaTitle: string;
  description?: string;
  descriptionDraft?: boolean;
  eyebrow: string;
  meta: MetaPair[];
  /**
   * The artifacts this page can be checked against. They sit in the rail with
   * the rest of the metadata rather than in a row across the prose, because
   * that is what they are — where to go to verify the page, not a step in its
   * argument.
   */
  links?: RailLink[];
  /** The label above the rail links. Artifacts say "Open"; essays name their group. */
  linksLabel?: string;
  /**
   * The group's own heading, carried verbatim from essayGroups.ts so the rail
   * says what the index says. Its presence switches the list to the prose face,
   * because essay titles are sentences and the artifact labels are not.
   */
  linksTitle?: string;
  current?: string;
  related?: [string, string][];
}

const {
  title,
  deck,
  titleDraft,
  pull,
  metaTitle,
  description,
  descriptionDraft,
  eyebrow,
  meta,
  links = [],
  linksLabel = 'Open',
  linksTitle,
  current,
  related,
} = Astro.props;
---

<BaseLayout
  title={metaTitle}
  description={description}
  descriptionDraft={descriptionDraft}
  current={current}
  related={related}
>
  <article class="shell doc">
    <PageHead eyebrow={eyebrow} title={title} deck={deck}>
      {titleDraft ? <Draft>{title}</Draft> : title}
    </PageHead>

    <div class="columns">
      <aside class="rail" aria-label="Metadata">
        <dl>
          {
            meta.map(([label, value]) => (
              <div class="row">
                <dt>{label}</dt>
                <dd set:html={value} />
              </div>
            ))
          }
        </dl>

        {
          links.length > 0 && (
            <div class:list={['rail-links', { 'rail-group': linksTitle }]}>
              <p class="rail-links-label">{linksLabel}</p>
              {linksTitle && <p class="rail-links-title">{linksTitle}</p>}
              <ul>
                {links.map((l) =>
                  l.sheet ? (
                    <li>
                      <button class="link sheet-open" type="button" data-sheet={l.sheet}>
                        {l.label}<Chevron weight="light" /></button>
                    </li>
                  ) : l.current ? (
                    <li class="is-current" aria-current="page">
                      {l.label}
                    </li>
                  ) : (
                    <li>
                      <a
                        class="link"
                        href={l.href}
                        target={l.external || l.href.startsWith('http') ? '_blank' : undefined}
                        rel={l.external || l.href.startsWith('http') ? 'noopener' : undefined}
                      >
                        {l.label}<Chevron weight="light" /></a>
                    </li>
                  ),
                )}
              </ul>
            </div>
          )
        }
      </aside>

      <div class="prose">
        {pull && <p class="pull">{pull}</p>}
        <slot />
      </div>
    </div>
  </article>

  <slot name="after" />
</BaseLayout>

<style is:global>
  /* Global rather than scoped: the prose styles have to reach markdown rendered
     by <Content />, and both essays and hand-authored case studies use them. */
  /* Every page's first line lands at the same height. This was 64px here and
     88px on /essays, and the eyebrow's default paragraph margin pushed the
     document pages down further still — so titles jumped vertically whenever you
     moved between the two. One token, and the eyebrow's margin zeroed. */
  .doc {
    padding-top: var(--space-page-top);
  }

  /* Colour and weight come from `.label` in global.css; only the spacing is
     this layout's business. */

  /* Diagrams recovered from the live site. These are the instruments the essays
     describe — scoring rubrics, before/after tables, the two-by-twos — so they
     run the full measure of the prose column rather than sitting inline. Every
     one shipped with empty alt text originally; each now describes itself. */
  /* Global, alongside .essay-fig. Scoped to the page these did not apply at all —
     the rules were emitted but never matched — so the iframe fell back to its
     replaced-element default of 300x150 and the caption rendered as body copy. */
  /* ---- colophon ---------------------------------------------------------
     Global, like .essay-fig and .figma: scoped to the page these rules are
     emitted but never match, so the layout silently falls back to prose. */

  /* Four equal cells, tinted alternately across the row. Same banding as the
     lists below, turned on its side. No rule and no gap — the tint does the
  /* The prose list marker out-specifies a plain override, and these lists are
     not prose. Everywhere a custom list appears on this page, the marker is off. */
  .doc .principles > li::before,
  .doc .ledger > li::before,
  .doc .ledger-compare li::before {
    content: none !important;
  }

  .doc .principles,
  .doc .ledger {
    list-style: none;
    margin: 24px 0 30px;
    padding: 0;
  }

  /* Banded rather than ruled. The tint bleeds past the text on both sides so the
     copy stays aligned with the prose above it instead of being inset by the
     padding. */
  .doc .principles > li,
  .doc .ledger > li {
    margin: 0;
    padding: 15px 16px;
    margin-inline: -16px;
    border: 0;
  }

  .doc .principle {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.35;
  }

  .doc .principle-detail,
  .doc .gate-req {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-ink);
  }

  .doc .gate-req {
    color: var(--color-ink);
  }

  .doc .gate-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 8px 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0;
  }

  /* No marker beside these. The words already say which is which, so a square or
     a circle repeated the label in a second language. */
  .doc .gate-mode {
    color: var(--color-ink-3);
  }

  .doc .gate-how {
    color: var(--color-ink-3);
    text-transform: none;
    letter-spacing: 0;
  }

  /* Paired rows, banded like the lists above. Tighter than those, because each
     cell is one line rather than a heading and a paragraph. */
  .doc .ledger-compare {
    margin: 26px 0 30px;
  }

  .doc .ledger-row {
    display: grid;
    gap: 2px 40px;
    padding: 9px 16px;
    margin-inline: -16px;
  }

  .doc .ledger-row:nth-of-type(even) {
    background: var(--color-band-a);
  }

  .doc .ledger-row p {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
  }

  .doc .ledger-row .was {
    color: var(--color-ink);
  }

  .doc .ledger-heads {
    display: none;
    padding-bottom: 4px;
    background: none !important;
  }

  .doc .ledger-heads p {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-ink-3);
  }

  /* Stacked, each line needs its own label; side by side, the column heads carry
     it and repeating the word on every row is noise. */
  .doc .ledger-compare .tag {
    display: inline-block;
    min-width: 62px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0;
    color: var(--color-ink-3);
  }

  .doc .pull-line {
    text-wrap: pretty;
    /* The rule sits on the prose's own left edge, in line with the paragraphs
       above and below it. The gap to the quote is 26px rather than 16 — the
       rule needs room around it, not a tighter grip on the text. */
    margin: 26px 0 34px;
    padding-left: 26px;
    border-left: 4px solid var(--color-ink);
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.012em;
  }

  .doc .result-line {
    text-wrap: pretty;
    margin: 22px 0 14px;
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 620;
    letter-spacing: -0.012em;
  }

  /* The ratio tables. These had no styles at all, so the swatch collided with the
     label and the column headers ran together. Banded to match the rows above,
     numbers right-aligned and monospaced so they compare down the column. */
  .doc .ratios {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 10px;
    font-size: 15px;
  }

  .doc .ratios th {
    padding: 0 14px 9px 16px;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-ink-3);
    border-bottom: 1px solid var(--color-rule);
  }

  .doc .ratios td {
    padding: 10px 14px 10px 16px;
    vertical-align: middle;
  }

  .doc .ratios .num {
    width: 1%;
    text-align: right;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .doc .ratios .dim {
    color: var(--color-ink-3);
  }

  .doc .ratios .use {
    font-size: 13px;
    color: var(--color-ink);
  }

  /* The swatch is the evidence: the pair rendered at the ratio being claimed. */
  .doc .swatch {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 22px;
    margin-right: 12px;
    vertical-align: -6px;
    font-size: 12px;
    line-height: 1;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--color-rule);
  }

  .doc .all-pairs {
    margin: 0 0 34px;
  }

  /* The banded row the loop steps use, rather than a rule with small mono type
     under it. A disclosure is a thing you press, and a tinted band says that
     without a border and a type change having to say it between them. */
  .doc .all-pairs summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 12px 18px;
    background: var(--color-band-a);
    font-size: var(--text-note);
    letter-spacing: 0;
    color: var(--color-ink);
    cursor: pointer;
  }

  .doc .all-pairs summary:hover {
    color: var(--color-signal);
  }

  /* The disclosure gets the system caret rather than the browser's triangle,
     on the left where the affordance belongs — it points at the thing it will
     open. Same component the links use, so there is one caret on the site.

     It carries a left margin for its usual job of trailing a link, which is
     the wrong side here. */
  .doc .all-pairs summary::-webkit-details-marker {
    display: none;
  }

  .doc .all-pairs summary {
    list-style: none;
  }

  /* Caret and label sit together as a pair, spaced for each other rather than
     for the page grid. They are already inset by the band's own padding, and
     nothing outside the band shares that edge, so making them line up with the
     list markers would only pull them apart. */
  .doc .all-pairs summary .chev {
    margin: 0 10px 0 0;
    transition: transform 140ms ease;
  }

  /* Rotates to point down at what it opened. */
  .doc .all-pairs[open] summary .chev {
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .doc .all-pairs summary .chev {
      transition: none;
    }
  }

  /* The table scrolls inside its own box rather than pushing the document
     sideways on a narrow screen. */
  .doc .scroller {
    overflow-x: auto;
    padding-bottom: 4px;
  }







  @media (min-width: 700px) {
    .doc .ledger-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .doc .ledger-compare .tag {
      display: none;
    }

    .doc .ledger-heads {
      display: grid;
    }

  }






  /* The same envelope the figures wear on the index: mat, drawing inset on
     white. These sat bare on the page, so a figure that paints its own
     background bled to the column edge while one that does not showed page
     grey behind the drawing. */
  .doc .essay-fig {
    margin: var(--space-embed) 0;
    padding: 10px;
    border-radius: var(--radius-mat);
    background: var(--color-mount);
  }

  .doc .essay-fig img {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    padding: 20px;
    border-radius: var(--radius-inset);
    background: var(--color-paper-raised);
  }



  .doc .meta-warning {
    margin: 20px 0 0;
  }

  .doc .columns {
    margin-top: 56px;
    display: grid;
    gap: 40px;
    padding-top: 32px;
  }

  .doc .rail .meta-flag {
    margin: 0 0 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-rule);
    line-height: 1.9;
  }

  .doc .rail dl {
    margin: 0;
    display: grid;
    gap: 22px;
  }

  .doc .rail .row {
    display: grid;
    gap: 6px;
  }

  .doc .rail dt {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0;
    color: var(--color-ink-2);
  }

  .doc .rail dd {
    text-wrap: pretty;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.65;
    color: var(--color-ink);
  }

  /* The rail carries live URLs. Without an affordance they read as plain text —
     and the copy beside them refers to "both links", which is only true if a
     reader can see that they are links. */
  .doc .rail a {
    color: var(--color-signal);
    text-decoration: none;
    transition: opacity 120ms ease;
  }

  .doc .rail a:hover,
  .doc .rail a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The banded-cell pattern below, carrying a glyph. Layout and banding come
     from `.cells`; only what is particular to a legend lives here. */
  .doc .shape-key > li {
    text-align: center;
    padding: 22px 16px;
  }

  .doc .shape-key svg {
    display: block;
    margin: 0 auto 12px;
  }

  .doc .shape-key .glyph {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 2;
  }

  .doc .shape-key span {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0;
    color: var(--color-ink-3);
  }

  /* ---- banded cells ------------------------------------------------------- */

  /* Equal-width boxes, tinted alternately, grey first. This is the one pattern
     for a short row of parallel things — a pair of links, three questions, four
     figures. `.shape-key` above is the same pattern carrying a glyph, and reuses
     these rules rather than restating them. */
  /* Separate cards, not one continuous grid. Every remaining use of this is a
     strip of figures — three or four independent facts — and running them
     together in a banded block asked the reader to see a table where there is
     no table. A gap and a card each says they are peers, and nothing more. */
  .doc .cells {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    margin: 26px 0 var(--space-block);
    padding: 0;
  }

  .doc .cells > li {
    margin: 0;
    padding: 22px 20px;
    border-radius: var(--radius-mat);
    background: var(--color-paper-raised);
  }

  .doc .cells > li::before {
    content: none !important;
  }

  /* A column of single numbers wastes a phone screen; two-up is still legible. */
  .doc .cells.four {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* A cell holds a label and one of: a line of text, a host, or a figure. The
     label reads as a caption under a figure and as a heading above prose, so the
     spacing is set by what it sits next to rather than baked into the label. */
  .doc .cell-label {
    display: block;
    margin: 0 !important;
    font-family: var(--font-mono) !important;
    font-size: 13px !important;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0;
    color: var(--color-ink-3) !important;
  }

  .doc .cell-note {
    display: block;
    margin: 8px 0 0 !important;
  }

  .doc .cell-note {
    font-size: 16px !important;
    line-height: 1.45 !important;
    text-wrap: pretty;
  }

  .doc .cell-figure {
    text-wrap: pretty;
    display: block;
    margin: 0 !important;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 620;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .doc .cell-figure + .cell-label {
    margin-top: 5px !important;
  }

  /* A short qualifier under a figure or a strip of them — smaller than body,
     the same grey as a caption, so it reads as a footnote to the thing above it
     rather than as the next paragraph. */
  .doc .note-line {
    text-wrap: pretty;
    margin: -18px 0 var(--space-block) !important;
    font-family: var(--font-mono) !important;
    font-size: 13.5px !important;
    line-height: 1.7 !important;
    letter-spacing: 0;
    color: var(--color-ink-3) !important;
  }

  /* ---- static state captures ---------------------------------------------- */

  /* Component states captured from the library, shown side by side. Live embeds
     are the primary evidence; loading a separate iframe for every variant would
     cost more than it proves, so secondary states are images.

     Captured at one viewport width so they are directly comparable, then shown
     at their natural height. An earlier version forced them into a common 4:3
     box: at 654x1212 that cropped away everything below the photograph, so a
     caption reading "the card expands to support a larger procedure set" sat
     above an image with no procedures in it. Ragged bottoms are the cheaper
     problem.

     The anatomy matches a live embed exactly — a header naming the state and the
     surface, then the evidence, then one caption saying what to look at. It used
     to carry three labels in two places: a blue surface tag above the image and
     a black state name below it, which read as two competing titles for the same
     thing. */
  .doc .captures {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    margin: 30px 0 var(--space-block);
    padding: 0;
  }

  /* One tinted surface per capture, the same one the compare block uses. It
     had a border around the card and a rule under the header and another above
     the note — three edges dividing three things that space already separates,
     on a screenshot that has its own edges. */
  .doc .captures > li {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 10px 10px 12px;
    align-self: start;
    border: 0;
    border-radius: var(--radius-mat);
    background: var(--color-mount);
  }

  .doc .captures > li::before {
    content: none !important;
  }

  .doc .capture-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    padding: 0;
    font-size: 13px;
    letter-spacing: 0;
  }

  .doc .capture-name {
    text-wrap: pretty;
    font-weight: 600;
    color: var(--color-ink);
  }

  .doc .capture-surface {
    color: var(--color-ink-2);
  }

  /* The screenshot keeps a corner so it reads as mounted on the surface rather
     than bleeding out of it. */
  .doc .capture-shot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-inset);
  }

  /* Inside the card's own padding. The grid gap above it is the only space it
     needs, so it carries none of its own. */
  .doc .capture-note {
    display: block;
    --foot-pad: 0;
  }

  /* ---- the equipment junction --------------------------------------------- */

  /* ---- the review loop ---------------------------------------------------- */

  /* A sequence, not a cycle. Banded like every other list on the site — no
     rules, no arrows, no animation — with the two stages a person is
     accountable for named in words, because the argument of the page is that
     those two are not removable. */
  .doc .loop {
    list-style: none;
    margin: 30px 0 var(--space-block);
    padding: 0;
  }

  .doc .loop > li {
    margin: 0;
    padding: 16px 18px;
  }

  .doc .loop > li::before {
    content: none !important;
  }

  /* ONE banding rule for the whole site.
     There were five of these, in four places, with three different treatments —
     which is why changing the ledger's colours left the principles list, the
     before/now ledger, the ratio table and the cells grid on the old grey. A
     new banded pattern joins this selector list; it does not get its own
     nth-child rule with its own colours. */
  .doc .loop > li:nth-child(odd),
  .doc .principles > li:nth-child(odd),
  .doc .ledger > li:nth-child(odd),
  .doc .ratios tbody tr:nth-child(odd) {
    background: var(--color-band-a);
  }

  .doc .loop > li:nth-child(even),
  .doc .principles > li:nth-child(even),
  .doc .ledger > li:nth-child(even),
  .doc .ratios tbody tr:nth-child(even) {
    background: var(--color-band-b);
  }

  /* A banded block is one object, so it is rounded like one: the outer corners
     take the mat radius and the rows between them stay square. Joins the same
     selector list as the colours — a new banded pattern inherits both or
     neither. */
  .doc .loop,
  .doc .principles,
  .doc .ledger,
  .doc .ratios {
    border-radius: var(--radius-mat);
    overflow: hidden;
  }

  .doc .loop-actor {
    display: block;
    margin: 0 !important;
    font-family: var(--font-mono) !important;
    font-size: 13.5px !important;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-ink) !important;
  }

  .doc .loop-what {
    text-wrap: pretty;
    display: block;
    margin: 6px 0 0 !important;
    font-size: 17px !important;
    line-height: 1.45 !important;
  }


  @media (min-width: 700px) {
    .doc .cells.two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .doc .cells.three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .doc .cells.four {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .doc .captures.two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .doc .captures.three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Two columns now: who, and what they do. The third held the sign-off tag
       and went with it. The first is sized to the longest actor name, not to a
       fraction of the page — a wide column holding a short label is a gap. */
    .doc .loop > li {
      display: grid;
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
      gap: 24px;
      align-items: baseline;
    }

    .doc .loop-what {
      margin: 0 !important;
    }
  }

  .doc .prose {
    max-width: 68ch;

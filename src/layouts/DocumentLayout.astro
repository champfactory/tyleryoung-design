---
/**
 * The long-form document: essays and case studies share one anatomy.
 *
 * eyebrow · H1 · metadata rail · prose · (optional) cross-links
 *
 * The live site's essay anatomy is preserved (docs/02-content-inventory.md says
 * "preserve exactly — it works"); only the visual register changed. Case studies
 * use the same shell so a technical piece reads as a sibling of the leadership
 * essays rather than a bolt-on.
 */
import BaseLayout from './BaseLayout.astro';
import Needs from '../components/Needs.astro';
import Draft from '../components/Draft.astro';

export type MetaPair = [label: string, value: string];

interface Props {
  title: string;
  /** the original full sentence, kept under the short title */
  deck?: string;
  /** true when the short title is mine, not Tyler's */
  titleDraft?: boolean;
  /** one verbatim line from the body, surfaced above the prose */
  pull?: string;
  metaTitle: string;
  description?: string;
  descriptionDraft?: boolean;
  eyebrow: string;
  meta: MetaPair[];
  current?: string;
  related?: [string, string][];
}

const {
  title,
  deck,
  titleDraft,
  pull,
  metaTitle,
  description,
  descriptionDraft,
  eyebrow,
  meta,
  current,
  related,
} = Astro.props;
---

<BaseLayout
  title={metaTitle}
  description={description}
  descriptionDraft={descriptionDraft}
  current={current}
  related={related}
>
  <article class="shell doc">
    <header class="head">
      <p class="label">{eyebrow}</p>
      <h1 class="display">{titleDraft ? <Draft>{title}</Draft> : title}</h1>
      {deck && <p class="deck">{deck}</p>}
    </header>

    <div class="columns">
      <aside class="rail" aria-label="Metadata">
        <dl>
          {
            meta.map(([label, value]) => (
              <div class="row">
                <dt>{label}</dt>
                <dd set:html={value} />
              </div>
            ))
          }
        </dl>
      </aside>

      <div class="prose">
        {pull && <p class="pull">{pull}</p>}
        <slot />
      </div>
    </div>
  </article>

  <slot name="after" />
</BaseLayout>

<style is:global>
  /* Global rather than scoped: the prose styles have to reach markdown rendered
     by <Content />, and both essays and hand-authored case studies use them. */
  /* Every page's first line lands at the same height. This was 64px here and
     88px on /essays, and the eyebrow's default paragraph margin pushed the
     document pages down further still — so titles jumped vertically whenever you
     moved between the two. One token, and the eyebrow's margin zeroed. */
  .doc {
    padding-top: var(--space-page-top);
  }

  .doc .head .label {
    margin-top: 0;
  }

  /* Diagrams recovered from the live site. These are the instruments the essays
     describe — scoring rubrics, before/after tables, the two-by-twos — so they
     run the full measure of the prose column rather than sitting inline. Every
     one shipped with empty alt text originally; each now describes itself. */
  /* Global, alongside .essay-fig. Scoped to the page these did not apply at all —
     the rules were emitted but never matched — so the iframe fell back to its
     replaced-element default of 300x150 and the caption rendered as body copy. */
  /* ---- colophon ---------------------------------------------------------
     Global, like .essay-fig and .figma: scoped to the page these rules are
     emitted but never match, so the layout silently falls back to prose. */

  /* Four equal cells, tinted alternately across the row. Same banding as the
     lists below, turned on its side. No rule and no gap — the tint does the
     separating, and 1fr keeps every box the same width whatever its label does. */
  .doc .proof {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 30px 0 10px;
    padding: 0;
    border: 0;
  }

  /* Scoped under .prose deliberately. The prose rule `.doc .prose > ul > li` sets
     padding-left: 38px for the list marker and out-specifies a plainer selector,
     so the band started where it was told and the text sat 38px inside it. */
  .doc .proof > li {
    margin: 0;
    padding: 20px 18px;
  }

  .doc .proof > li:nth-child(odd) {
    background: var(--color-row);
  }

  /* The prose list marker out-specifies a plain override, and these lists are
     not prose. Everywhere a custom list appears on this page, the marker is off. */
  .doc .proof li::before,
  .doc .principles > li::before,
  .doc .ledger > li::before,
  .doc .compare li::before {
    content: none !important;
  }

  .doc .proof-figure {
    display: block;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 620;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .doc .proof-label {
    display: block;
    margin-top: 5px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .doc .principles,
  .doc .ledger {
    list-style: none;
    margin: 24px 0 30px;
    padding: 0;
  }

  /* Banded rather than ruled. The tint bleeds past the text on both sides so the
     copy stays aligned with the prose above it instead of being inset by the
     padding. */
  .doc .principles > li,
  .doc .ledger > li {
    margin: 0;
    padding: 15px 16px;
    margin-inline: -16px;
    border: 0;
  }

  .doc .principles > li:nth-child(odd),
  .doc .ledger > li:nth-child(odd) {
    background: var(--color-row);
  }

  .doc .principle {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.35;
  }

  .doc .principle-detail,
  .doc .gate-req {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-ink);
  }

  .doc .gate-req {
    color: var(--color-ink);
  }

  .doc .gate-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 8px 0 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.07em;
  }

  /* No marker beside these. The words already say which is which, so a square or
     a circle repeated the label in a second language. */
  .doc .gate-mode {
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .doc .gate-how {
    color: var(--color-ink-3);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  /* Paired rows, banded like the lists above. Tighter than those, because each
     cell is one line rather than a heading and a paragraph. */
  .doc .compare {
    margin: 26px 0 30px;
  }

  .doc .compare-row {
    display: grid;
    gap: 2px 40px;
    padding: 9px 16px;
    margin-inline: -16px;
  }

  .doc .compare-row:nth-of-type(even) {
    background: var(--color-row);
  }

  .doc .compare-row p {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
  }

  .doc .compare-row .was {
    color: var(--color-ink);
  }

  .doc .compare-heads {
    display: none;
    padding-bottom: 4px;
    background: none !important;
  }

  .doc .compare-heads p {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  /* Stacked, each line needs its own label; side by side, the column heads carry
     it and repeating the word on every row is noise. */
  .doc .compare .tag {
    display: inline-block;
    min-width: 62px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .doc .pull-line {
    margin: 26px 0 34px;
    padding-left: 16px;
    border-left: 2px solid var(--color-signal);
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.012em;
  }

  .doc .result-line {
    margin: 22px 0 14px;
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 620;
    letter-spacing: -0.012em;
  }

  /* The ratio tables. These had no styles at all, so the swatch collided with the
     label and the column headers ran together. Banded to match the rows above,
     numbers right-aligned and monospaced so they compare down the column. */
  .doc .ratios {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 10px;
    font-size: 15px;
  }

  .doc .ratios th {
    padding: 0 14px 9px 16px;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    border-bottom: 1px solid var(--color-rule);
  }

  .doc .ratios td {
    padding: 10px 14px 10px 16px;
    vertical-align: middle;
  }

  .doc .ratios tbody tr:nth-child(odd) {
    background: var(--color-row);
  }

  .doc .ratios .num {
    width: 1%;
    text-align: right;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .doc .ratios .dim {
    color: var(--color-ink-3);
  }

  .doc .ratios .use {
    font-size: 13px;
    color: var(--color-ink);
  }

  /* The swatch is the evidence: the pair rendered at the ratio being claimed. */
  .doc .swatch {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 22px;
    margin-right: 12px;
    vertical-align: -6px;
    font-size: 12px;
    line-height: 1;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--color-rule);
  }

  .doc .all-pairs {
    margin: 0 0 34px;
    border-top: 1px solid var(--color-rule);
  }

  .doc .all-pairs summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    cursor: pointer;
  }

  .doc .all-pairs summary:hover {
    color: var(--color-signal);
  }

  /* The table scrolls inside its own box rather than pushing the document
     sideways on a narrow screen. */
  .doc .scroller {
    overflow-x: auto;
    padding-bottom: 4px;
  }







  @media (min-width: 700px) {
    .doc .proof {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .doc .compare-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .doc .compare .tag {
      display: none;
    }

    .doc .compare-heads {
      display: grid;
    }

  }

  /* No .figma block here. It predated the .recon pattern and fought it — a dark
     background on the whole figure hid the status header, and a mono-caps
     figcaption made this one embed's note look unlike every other one. The
     figure carries `recon figma`, so it inherits the shared pattern and only the
     viewport needs the dark ground. */
  .doc .figma-viewport {
    aspect-ratio: 16 / 10;
    background: #1e1e1e;
  }

  .doc .figma-viewport iframe {
    width: 100%;
    height: 100%;
    transform: none;
    pointer-events: auto;
  }

  .doc .flows {
    display: grid;
    gap: 0;
    margin: 22px 0 34px;
    border-top: 1px solid var(--color-rule);
  }

  .doc .flow {
    padding: 14px 16px;
    border-bottom: 1px solid var(--color-rule);
  }

  .doc .flow-name {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .doc .flow-steps {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  .doc .flow-step {
    margin: 0;
    padding: 0;
    font-size: 15px;
    line-height: 1.4;
  }

  .doc .flow-step::before {
    content: none !important;
  }

  .doc .flow-step + .flow-step::after {
    content: none;
  }

  /* The arrow belongs between steps, so it is drawn before every step but the
     first rather than after every step including the last. */
  .doc .flow-step + .flow-step {
    position: relative;
    padding-left: 20px;
  }

  .doc .flow-step + .flow-step::marker {
    content: '';
  }

  .doc .flow-step + .flow-step {
    background-image: none;
  }

  .doc .flow-steps > li + li::first-letter {
    letter-spacing: inherit;
  }

  /* The dashboard is where three of the four flows begin — marked so the shared
     hub is visible without a second diagram. */
  .doc .flow-step.hub {
    font-weight: 600;
  }

  /* ---- disclosure ---------------------------------------------------------- */

  .doc .disclosure {
    margin: 40px 0 0;
    padding: 22px 20px 6px;
    border-top: 1px solid var(--color-rule);
    background: var(--color-row);
  }

  .doc .disclosure .sec-eyebrow,

  .doc .disclosure .sec-eyebrow {
    margin-top: 0;
    color: var(--color-ink-3);
  }

  .doc .disclosure h2 {
    margin-top: 0;
    padding-top: 0;
  }

  .doc .disclosure p {
    font-size: 16px;
    line-height: 1.5;
    margin: 0 0 14px;
  }


  @media (min-width: 700px) {
    .doc .strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-bottom: 1px solid var(--color-rule);
    }

    .doc .strip.four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .doc .strip > li {
      border-bottom: 0;
    }

    .doc .strip.four > li:nth-child(-n + 2) {
      border-bottom: 1px solid var(--color-rule);
    }
  }

  /* One descending scale: mono eyebrow 11, h2 28, h3 21, body 20. The h2 used to
     be 15px uppercase, which read as a label and sat below its own h3 at 22px —
     so a section heading ranked under the heading inside it. Uppercase now
     belongs to the eyebrow alone, where it does not compete. */
  .doc .prose > h2:not([class]) {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.018em;
    font-size: var(--text-h2);
    line-height: 1.22;
    color: var(--color-ink);
    margin: var(--space-section) 0 20px;
  }

  .doc .prose > h2:not([class]):first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .doc .prose > h3:not([class]) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-h3);
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin: var(--space-heading) 0 14px;
  }

  /* Direct children only. As a descendant selector this out-specifies Astro's
     scoped component styles and reformats every <p> inside an embedded
     component — e.g. the Receipt's pane labels. */
  .doc .prose > p:not([class]) {
    font-size: var(--text-body);
    line-height: 1.5;
    margin: 0 0 16px;
    text-wrap: pretty;
  }

  .doc .prose > ol:not([class]),
  .doc .prose > ul:not([class]) {
    margin: 0 0 22px;
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 14px;
    counter-reset: item;
  }

  .doc .prose > ol:not([class]) > li,
  .doc .prose > ul:not([class]) > li {
    font-size: 19px;
    line-height: 1.6;
    padding-left: 38px;
    position: relative;
    text-wrap: pretty;
  }

  .doc .prose > ol:not([class]) > li {
    counter-increment: item;
  }

  .doc .prose > ol:not([class]) > li::before {
    content: counter(item, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.42em;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-signal);
  }

  .doc .prose > ul:not([class]) > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 22px;
    height: 1px;
    background: var(--color-rule-strong);
  }

  .doc .prose > p a,
  .doc .prose > ul a,
  .doc .prose > ol a {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  /* a pull-out for facts that are not prose — used by the case studies */
  .doc .prose .aside {
    margin: 0 0 22px;
    padding: 18px 20px;
    background: var(--color-paper-sunk);
    border-left: 2px solid var(--color-signal);
  }

  .doc .prose .aside p {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.8;
    letter-spacing: 0.03em;
    margin: 0;
    color: var(--color-ink);
  }

  @media (min-width: 810px) {
    /* No padding-top override here. A `.doc { padding-top: 96px }` in this media
       query quietly beat the shared token at every desktop width, so document
       pages started lower than /essays and the title jumped when you moved
       between them. */
    .doc .columns {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 56px;
    }

    .doc .rail {
      position: sticky;
      top: 96px;
      align-self: start;
    }
  }

  @media (min-width: 1200px) {
    .doc .columns {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 80px;
    }
  }
</style>

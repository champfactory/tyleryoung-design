---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** true when the description is copy I drafted, not copy Tyler approved */
  descriptionDraft?: boolean;
  current?: string;
  related?: [string, string][];
}

const { title, description, descriptionDraft, current, related } = Astro.props;

// The live site ships "Made with Framer" on every essay page. Rather than invent
// copy, emit an obvious marker so the gap shows up in view-source and in an audit.
const metaDescription = description ?? '[NEEDS: meta description]';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {
      descriptionDraft && (
        <Fragment set:html="<!-- DRAFT-META: description below is drafted, not approved -->" />
      )
    }
    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f6f4ef" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer related={related} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 40;
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 12px 20px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .skip:focus {
    left: 0;
  }
</style>

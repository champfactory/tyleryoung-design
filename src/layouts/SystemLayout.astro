---
/**
 * A separate property, not a page of the portfolio.
 *
 * No nav, no footer, no metadata rail — arriving here should feel like opening
 * the Storybook or the Figma file, because that is what it is: an artifact the
 * case study points at. It carries the site's tokens so it cannot describe a
 * system it does not use, and nothing else.
 *
 * Dark on purpose. The portfolio is paper; a spec sheet is an instrument
 * panel, and the machine tokens already existed for exactly that.
 */
import '../styles/global.css';

interface Props {
  metaTitle: string;
  description: string;
  /**
   * The only heading. It is the page's h1 — styled as a label rather than a
   * display line, because a spec sheet is named, not introduced. There was a
   * sentence-length title above the first token and a link back to the
   * portfolio; both were removed, and the tab is the way back.
   */
  kicker: string;
}

const { metaTitle, description, kicker } = Astro.props;
---

<!doctype html>
<html lang="en" class="sys-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="robots" content="index,follow" />
  </head>
  <body class="sys">
    <a class="sys-skip" href="#main">Skip to content</a>

    <header class="sys-head">
      <div class="sys-wrap">
        <h1 class="sys-kicker">{kicker}</h1>
      </div>
    </header>

    <main id="main" class="sys-wrap">
      <slot />
    </main>

  </body>
</html>

<style is:global>
  /* Its own type: mono for every label and heading, because a spec sheet reads
     as one. The portfolio's prose face carries the descriptions so the two are
     never confused for each other. */
  /* The canvas, not just the body: overscroll paints the root's background, so
     rubber-banding on the portfolio's ground would flash paper over this. Same
     rule the main site follows, pointed at the other surface. */
  html.sys-root {
    background-color: var(--color-machine);
  }

  /* global.css puts the page grey on <main> — the arrangement the portfolio
     needs and this property does not. */
  body.sys main {
    background: none;
    padding-block: 0;
  }

  body.sys {
    margin: 0;
    background: var(--color-machine);
    color: var(--color-machine-ink);
    font-family: var(--font-prose);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .sys-wrap {
    max-width: 900px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  @media (min-width: 810px) {
    .sys-wrap {
      padding-inline: 48px;
    }
  }

  .sys-skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 40;
    padding: 12px 20px;
    background: var(--color-machine-ink);
    color: var(--color-machine);
    font-family: var(--font-code);
    font-size: 12px;
  }

  .sys-skip:focus {
    left: 0;
  }

  .sys-head {
    padding: 56px 0 8px;
  }



  body.sys .sys-kicker {
    margin: 0;
    font-family: var(--font-code);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-machine-ink-2);
  }


  body.sys h2 {
    margin: 88px 0 0;
    font-family: var(--font-code);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-machine-ink-2);
  }

  /* No measure cap. These are one- to three-line descriptions above the family
     they describe, and a cap made them stop at 62ch while the table under them
     ran the full column — two left edges agreeing and two right edges not. The
     wrap is narrower than the portfolio's for the same reason. */
  body.sys main > p {
    margin: 18px 0 0;
    color: var(--color-machine-ink-2);
    text-wrap: pretty;
  }

  body.sys main > h2 + p {
    margin-top: 16px;
  }

  body.sys code {
    font-family: var(--font-code);
    font-size: 0.92em;
    color: var(--color-machine-ink);
  }


  :focus-visible {
    outline: 1px solid var(--color-machine-signal);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
